let len_ok (_: unit) : Lemma (L.length tbl_list == 4320)
  = assert_norm (L.length tbl_list == 4320)

[@@"opaque_to_smt"; FStar.Custard.no_specialize]
let tbl_seq : Seq.seq S64.t = Seq.seq_of_list tbl_list

let tbl_arr : (a: G.static_array S64.t
                  { G.static_array_elems a == tbl_seq /\
                    Seq.length (G.static_array_elems a) == 4320 })
  = reveal_opaque (`%tbl_seq) tbl_seq;
    len_ok ();
    G.mk_static_array tbl_list

