let po_12 () : Lemma (is_prime 9350987) =
  let l4 : list entry = [] in
  all_prime_nil ();
  let l3 : list entry = (1201, 2, 7529375) :: l4 in
  po_11 (); all_prime_cons 1201 2 7529375 l4;
  let l2 : list entry = (229, 2, 1732635) :: l3 in
  po_10 (); all_prime_cons 229 2 1732635 l3;
  let l1 : list entry = (17, 2, 7777718) :: l2 in
  po_9 (); all_prime_cons 17 2 7777718 l2;
  let l0 : list entry = (2, 2, 4675493) :: l1 in
  po_0 (); all_prime_cons 2 2 4675493 l1;
  assert_norm (pock 9350987 [(2, 2, 4675493); (17, 2, 7777718); (229, 2, 1732635); (1201, 2, 7529375)]);
  assert (l0 == [(2, 2, 4675493); (17, 2, 7777718); (229, 2, 1732635); (1201, 2, 7529375)]);
  pock_sound 9350987 l0

