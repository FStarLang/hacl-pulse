(** Primality of the group orders of P-256 and secp256k1.

    The field primes are certified in {!Spec.Group.Primes}; the orders are
    what ECDSA inverts modulo, and what makes every nonzero scalar
    invertible, so they need certificates too.  These are recursive
    Pocklington certificates in exactly the format of {!Spec.Group.Primes},
    produced by [spec/group-gen/primes/pocklington.gp] with the two orders
    in place of the field primes, and checked by
    {!Spec.Group.Prime.pock_sound} and {!Spec.Group.Prime.trial_sound}: the
    computer-algebra system is not trusted, only its witnesses are used. *)
module Spec.Group.OrderPrimes

open FStar.Math.Euclid
open Spec.Group.Prime

#set-options "--fuel 0 --ifuel 0"

let po_0 () : Lemma (is_prime 2) =
  assert_norm (trial 2 2); trial_sound 2

let po_1 () : Lemma (is_prime 3) =
  assert_norm (trial 3 2); trial_sound 3

