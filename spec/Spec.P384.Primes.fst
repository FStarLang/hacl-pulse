(** Primality of the P-384 field prime and group order.

    Recursive Pocklington certificates in the format of
    {!Spec.Group.Primes}, produced by [spec/group-gen/p384/pocklington.gp]
    and checked by {!Spec.Group.Prime.pock_sound} and
    {!Spec.Group.Prime.trial_sound}: the computer-algebra system is not
    trusted, only its witnesses are used.  A certificate lists only as much
    of [N - 1] as Pocklington needs, a factored part [F] with [F^2 > N]. *)
module Spec.P384.Primes

open FStar.Math.Euclid
open Spec.Group.Prime

#set-options "--fuel 0 --ifuel 0"

let pr_0 () : Lemma (is_prime 2) =
  assert_norm (trial 2 2); trial_sound 2

let pr_1 () : Lemma (is_prime 19) =
  assert_norm (trial 19 2); trial_sound 19

let pr_2 () : Lemma (is_prime 67) =
  assert_norm (trial 67 2); trial_sound 67

let pr_3 () : Lemma (is_prime 3) =
  assert_norm (trial 3 2); trial_sound 3

let pr_4 () : Lemma (is_prime 47) =
  assert_norm (trial 47 2); trial_sound 47

let pr_5 () : Lemma (is_prime 157) =
  assert_norm (trial 157 2); trial_sound 157

let pr_6 () : Lemma (is_prime 1373) =
  assert_norm (trial 1373 2); trial_sound 1373

let pr_7 () : Lemma (is_prime 2213) =
  assert_norm (trial 2213 2); trial_sound 2213

let pr_8 () : Lemma (is_prime 2862218959) =
  let l5 : list entry = [] in
  all_prime_nil ();
  let l4 : list entry = (2213, 2, 1800090976) :: l5 in
  pr_7 (); all_prime_cons 2213 2 1800090976 l5;
  let l3 : list entry = (1373, 2, 1473717517) :: l4 in
  pr_6 (); all_prime_cons 1373 2 1473717517 l4;
  let l2 : list entry = (157, 2, 2328243550) :: l3 in
  pr_5 (); all_prime_cons 157 2 2328243550 l3;
  let l1 : list entry = (3, 2, 744815756) :: l2 in
  pr_3 (); all_prime_cons 3 2 744815756 l2;
  let l0 : list entry = (2, 3, 1431109479) :: l1 in
  pr_0 (); all_prime_cons 2 3 1431109479 l1;
  assert_norm (pock 2862218959 [(2, 3, 1431109479); (3, 2, 744815756); (157, 2, 2328243550); (1373, 2, 1473717517); (2213, 2, 1800090976)]);
  assert (l0 == [(2, 3, 1431109479); (3, 2, 744815756); (157, 2, 2328243550); (1373, 2, 1473717517); (2213, 2, 1800090976)]);
  pock_sound 2862218959 l0

