let tp16 (m: nat { m < 9 }) : ext_point =
  if m = 0 then point_at_infinity
  else if m = 1 then b16
  else if m = 2 then e16_2
  else if m = 3 then e16_3
  else if m = 4 then e16_4
  else if m = 5 then e16_5
  else if m = 6 then e16_6
  else if m = 7 then e16_7
  else e16_8

let tp16_ok0 (_: unit)
  : Lemma (CB.affine (tp16 0) /\ CB.isq (tp16 0) (0 * pow2 128))
  = CB.isq_zero (0 * pow2 128)

let tp16_ok1 (_: unit)
  : Lemma (CB.affine (tp16 1) /\ CB.isq (tp16 1) (1 * pow2 128))
  = bq16_1 ();
    assert (n16 == pow2 128)

let tp16_ok2 (_: unit)
  : Lemma (CB.affine (tp16 2) /\ CB.isq (tp16 2) (2 * pow2 128))
  = e16_2_ok ();
