(** Tables 16 to 19 of the base-point comb, generated by
    [spec/group-gen/ed25519/comb.py].  Table [j] holds [m 256^j G] for [m] in [0..8],
    affine, each entry proved by the normaliser to be the previous one
    plus the table's base point.  See {!Spec.Ed25519.CombTable}. *)
module Spec.Ed25519.CombT4

module SM = Spec.Ed25519.Smul
module CB = Spec.Ed25519.Comb

open Spec.Curve25519
open Spec.Ed25519
open Spec.Ed25519.Group
open Spec.Ed25519.CombB

#push-options "--fuel 0 --ifuel 0 --z3rlimit 50"

(** {2 Table 16} *)

let bq16 (_: unit) : Lemma (CB.isq b16 n16)
  = b16_ok (); CB.isq_intro b16 n16

let bq16_1 (_: unit) : Lemma (CB.isq b16 (1 * n16))
  = bq16 (); CB.isq_one b16 n16

[@@"opaque_to_smt"]
let e16_2x : elem =
  assert_norm (54468161356533199495368251232949756902362822455729558615345521844455465083013 < prime);
