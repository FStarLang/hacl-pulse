let tp16_ok8 (_: unit)
  : Lemma (CB.affine (tp16 8) /\ CB.isq (tp16 8) (8 * pow2 128))
  = e16_8_ok ();
    assert (n16 == pow2 128)

let tp16_ok (m: nat { m < 9 })
  : Lemma (CB.affine (tp16 m) /\ CB.isq (tp16 m) (m * pow2 128))
  = if m = 0 then tp16_ok0 ()
    else if m = 1 then tp16_ok1 ()
    else if m = 2 then tp16_ok2 ()
    else if m = 3 then tp16_ok3 ()
    else if m = 4 then tp16_ok4 ()
    else if m = 5 then tp16_ok5 ()
    else if m = 6 then tp16_ok6 ()
    else if m = 7 then tp16_ok7 ()
    else (assert (m == 8); tp16_ok8 ())

