  8493667445341245648361292062270796651158721786810104163590154947632220300488

let e16_2 : ext_point = (e16_2x, e16_2y, one, e16_2t)

let e16_2_ok (_: unit) : Lemma (CB.isq e16_2 (2 * n16))
  = assert_norm (CB.ncheck e16_2 b16 b16);
