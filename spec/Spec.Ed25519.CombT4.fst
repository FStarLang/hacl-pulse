  : Lemma (CB.affine (tp19 m) /\ CB.isq (tp19 m) (m * pow2 152))
  = if m = 0 then tp19_ok0 ()
    else if m = 1 then tp19_ok1 ()
    else if m = 2 then tp19_ok2 ()
    else if m = 3 then tp19_ok3 ()
    else if m = 4 then tp19_ok4 ()
    else if m = 5 then tp19_ok5 ()
    else if m = 6 then tp19_ok6 ()
    else if m = 7 then tp19_ok7 ()
    else (assert (m == 8); tp19_ok8 ())

#pop-options
