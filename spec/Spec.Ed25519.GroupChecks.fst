    assert_norm (d2l % m0 == d2l);
    let io = kc c 19681161376707505956807079304988542015446066515923890162744021073123829784752 in
    let ep = kc c 1 in
    let dt = smul (kc c dl) (smul (smul (svar c 0) (svar c 1)) (smul (svar c 2) (svar c 3))) in
    let w = smul (smul (svar c 0) (svar c 1)) (sadd (smul io (svar c 2)) (svar c 3)) in
    let vv = sadd (smul io (svar c 0)) (smul ep (svar c 1)) in
    let k = sadd (sadd dt (smul (kc c 2) (smul (smul (svar c 0) (svar c 1)) io))) ep in
    kc_val c 19681161376707505956807079304988542015446066515923890162744021073123829784752;
    kc_val c 1;
