    let io = kc c 38214883241950591754978413199355411911188925816896391856984770930832735035197 in
    let ep = kc c 57896044618658097711785492504343953926634992332820282019728792003956564819948 in
    let dt = smul (kc c dl) (smul (smul (svar c 0) (svar c 1)) (smul (svar c 2) (svar c 3))) in
