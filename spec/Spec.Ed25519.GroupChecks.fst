let comp_pm (u1 v1 u2 v2: E.elem)
  : Lemma (requires on u1 v1 /\ on u2 v2)
          (ensures (let dt = E.fmul Ed.d (E.fmul (E.fmul u1 v1) (E.fmul u2 v2)) in let w = E.fmul (E.fmul u1 v1) (E.fadd (E.fmul (cst 19681161376707505956807079304988542015446066515923890162744021073123829784752) u2) v2) in let vv = E.fadd (E.fmul (cst 19681161376707505956807079304988542015446066515923890162744021073123829784752) u1) (E.fmul (cst 57896044618658097711785492504343953926634992332820282019728792003956564819948) v1) in E.fsub (E.fmul Ed.d (E.fmul w w)) (E.fmul vv vv) == E.fmul (E.fadd (E.fadd dt (E.fmul (cst 2) (E.fmul (E.fmul u1 v1) (cst 19681161376707505956807079304988542015446066515923890162744021073123829784752)))) (cst 57896044618658097711785492504343953926634992332820282019728792003956564819948)) (E.fsub dt (cst 57896044618658097711785492504343953926634992332820282019728792003956564819948))))
  = let env = [fromf u1; fromf v1; fromf u2; fromf v2] in
    comp_pm_ok o env;
    let c0 = base m0 fl o 4 env in
    comp_pm_ctx u1 v1 u2 v2;
    let c = with_hyps c0 [aff_hyp c0 0 1; aff_hyp c0 2 3] in
    envf4 c u1 v1 u2 v2;
    o_eqs (); m0_lem (); d_lem (); cst_lem ();
    let b = kc c d2l in
    assert_norm (d2l % m0 == d2l);
    let io = kc c 19681161376707505956807079304988542015446066515923890162744021073123829784752 in
    let ep = kc c 57896044618658097711785492504343953926634992332820282019728792003956564819948 in
    let dt = smul (kc c dl) (smul (smul (svar c 0) (svar c 1)) (smul (svar c 2) (svar c 3))) in
    let w = smul (smul (svar c 0) (svar c 1)) (sadd (smul io (svar c 2)) (svar c 3)) in
    let vv = sadd (smul io (svar c 0)) (smul ep (svar c 1)) in
    let k = sadd (sadd dt (smul (kc c 2) (smul (smul (svar c 0) (svar c 1)) io))) ep in
    kc_val c 19681161376707505956807079304988542015446066515923890162744021073123829784752;
    kc_val c 57896044618658097711785492504343953926634992332820282019728792003956564819948;
    kc_val c dl;
    kc_val c 2;
    assert (Nil? (fst (ssub (ssub (smul (kc c dl) (smul w w)) (smul vv vv)) (smul k (ssub dt ep)))));
    sv_eq (ssub (smul (kc c dl) (smul w w)) (smul vv vv)) (smul k (ssub dt ep));
    ()
#pop-options

(** Completeness certificate, iota = 38214883241950591754978413199355411911188925816896391856984770930832735035197, epsilon = 57896044618658097711785492504343953926634992332820282019728792003956564819948: [d w^2 - v^2] is a multiple of [delta - epsilon]. *)
let comp_mm_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 4 env in
  let hs = [aff_hyp c0 0 1; aff_hyp c0 2 3] in
  let c = with_hyps c0 hs in
  let b = kc c d2l in
  let io = kc c 38214883241950591754978413199355411911188925816896391856984770930832735035197 in
  let ep = kc c 57896044618658097711785492504343953926634992332820282019728792003956564819948 in
  let dt = smul (kc c dl) (smul (smul (svar c 0) (svar c 1)) (smul (svar c 2) (svar c 3))) in
  let w = smul (smul (svar c 0) (svar c 1)) (sadd (smul io (svar c 2)) (svar c 3)) in
  let vv = sadd (smul io (svar c 0)) (smul ep (svar c 1)) in
  let k = sadd (sadd dt (smul (kc c 2) (smul (smul (svar c 0) (svar c 1)) io))) ep in
  shapes hs &&
  Nil? (fst (ssub (ssub (smul (kc c dl) (smul w w)) (smul vv vv)) (smul k (ssub dt ep))))

let comp_mm_ok (o': fops m0) (env: list (elem m0)) : Lemma (comp_mm_chk o' env == true) =
  assert (comp_mm_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
