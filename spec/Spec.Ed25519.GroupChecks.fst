    let env = [fromf u1; fromf v1; fromf u2; fromf v2] in
    let c0 = base m0 fl o 4 env in
    base_ok m0 fl o 4 env;
    envf4 c0 u1 v1 u2 v2;
    aff_hyp_ok c0 0 1;
