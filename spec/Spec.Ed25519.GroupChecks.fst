(** Polynomial identities behind the Ed25519 group law.  Each [_chk] is a
    boolean computed by the normaliser (in [_ok]); the lemma of the same
    name reads it back as a statement about [Spec.Ed25519].  Generated by a
    script; the identities themselves were found with a computer-algebra
    system and are merely confirmed here. *)
module Spec.Ed25519.GroupChecks

open Spec.Group.Poly
open Spec.Group.Check
open Spec.Ed25519.GroupSv

module E = Spec.Curve25519
module Ed = Spec.Ed25519


(** Scaling the inputs scales the sum: an exact identity. *)
let add_scale_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 10 env in
  let c = c0 in
  let b = kc c d2l in
  let p = var4 #c 2 3 4 5 in
  let q = var4 #c 6 7 8 9 in
  let k = smul (smul (svar c 0) (svar c 1)) (smul (svar c 0) (svar c 1)) in
  let (a0, a1, a2, a3) = point_add_sv b (ksc (svar c 0) p) (ksc (svar c 1) q) in
  let (b0, b1, b2, b3) = ksc k (point_add_sv b p q) in
  Nil? (fst (ssub (a0) (b0))) &&
  Nil? (fst (ssub (a1) (b1))) &&
  Nil? (fst (ssub (a2) (b2))) &&
  Nil? (fst (ssub (a3) (b3)))

let add_scale_ok (o': fops m0) (env: list (elem m0)) : Lemma (add_scale_chk o' env == true) =
  assert (add_scale_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let add_scale (s w x1 y1 z1 t1 x2 y2 z2 t2: E.elem)
  : Lemma (ensures padd (sc s (x1, y1, z1, t1)) (sc w (x2, y2, z2, t2)) == sc (E.fmul (E.fmul s w) (E.fmul s w)) (padd (x1, y1, z1, t1) (x2, y2, z2, t2)))
  = let env = [fromf s; fromf w; fromf x1; fromf y1; fromf z1; fromf t1; fromf x2; fromf y2; fromf z2; fromf t2] in
    add_scale_ok o env;
    let c0 = base m0 fl o 10 env in
    o_ok (); base_ok m0 fl o 10 env;
    let c = c0 in
    envf10 c s w x1 y1 z1 t1 x2 y2 z2 t2;
    o_eqs (); m0_lem (); d_lem (); cst_lem ();
    let b = kc c d2l in
    assert_norm (d2l % m0 == d2l);
    let p = var4 #c 2 3 4 5 in
    let q = var4 #c 6 7 8 9 in
    let k = smul (smul (svar c 0) (svar c 1)) (smul (svar c 0) (svar c 1)) in
    let (a0, a1, a2, a3) = point_add_sv b (ksc (svar c 0) p) (ksc (svar c 1) q) in
    let (b0, b1, b2, b3) = ksc k (point_add_sv b p q) in
    var4_val c 2 3 4 5;
    var4_val c 6 7 8 9;
    ksc_val c (svar c 0) p;
    ksc_val c (svar c 1) q;
    point_add_val c b (ksc (svar c 0) p) (ksc (svar c 1) q);
    point_add_val c b p q;
    ksc_val c k (point_add_sv b p q);
    assert (Nil? (fst (ssub (a0) (b0))));
    sv_eq (a0) (b0);
    assert (Nil? (fst (ssub (a1) (b1))));
    sv_eq (a1) (b1);
    assert (Nil? (fst (ssub (a2) (b2))));
    sv_eq (a2) (b2);
    assert (Nil? (fst (ssub (a3) (b3))));
    sv_eq (a3) (b3);
    ()
#pop-options

(** Negation commutes with scaling. *)
let neg_scale_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 5 env in
  let c = c0 in
  let b = kc c d2l in
  let p = var4 #c 1 2 3 4 in
  let (a0, a1, a2, a3) = sneg (ksc (svar c 0) p) in
  let (b0, b1, b2, b3) = ksc (svar c 0) (sneg p) in
  Nil? (fst (ssub (a0) (b0))) &&
  Nil? (fst (ssub (a1) (b1))) &&
  Nil? (fst (ssub (a2) (b2))) &&
  Nil? (fst (ssub (a3) (b3)))

let neg_scale_ok (o': fops m0) (env: list (elem m0)) : Lemma (neg_scale_chk o' env == true) =
  assert (neg_scale_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let neg_scale (s x y z t: E.elem)
  : Lemma (ensures pneg (sc s (x, y, z, t)) == sc s (pneg (x, y, z, t)))
  = let env = [fromf s; fromf x; fromf y; fromf z; fromf t] in
    neg_scale_ok o env;
    let c0 = base m0 fl o 5 env in
    o_ok (); base_ok m0 fl o 5 env;
    let c = c0 in
    envf5 c s x y z t;
    o_eqs (); m0_lem (); d_lem (); cst_lem ();
    let b = kc c d2l in
    assert_norm (d2l % m0 == d2l);
    let p = var4 #c 1 2 3 4 in
    let (a0, a1, a2, a3) = sneg (ksc (svar c 0) p) in
    let (b0, b1, b2, b3) = ksc (svar c 0) (sneg p) in
    var4_val c 1 2 3 4;
    ksc_val c (svar c 0) p;
    sneg_val c (ksc (svar c 0) p);
    sneg_val c p;
    ksc_val c (svar c 0) (sneg p);
    assert (Nil? (fst (ssub (a0) (b0))));
    sv_eq (a0) (b0);
    assert (Nil? (fst (ssub (a1) (b1))));
    sv_eq (a1) (b1);
    assert (Nil? (fst (ssub (a2) (b2))));
    sv_eq (a2) (b2);
    assert (Nil? (fst (ssub (a3) (b3))));
    sv_eq (a3) (b3);
    ()
#pop-options

(** Scaling the input of doubling scales the output: an exact identity. *)
let dbl_scale_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 5 env in
  let c = c0 in
  let b = kc c d2l in
  let p = var4 #c 1 2 3 4 in
  let k = smul (smul (svar c 0) (svar c 0)) (smul (svar c 0) (svar c 0)) in
  let (a0, a1, a2, a3) = point_double_sv (ksc (svar c 0) p) in
  let (b0, b1, b2, b3) = ksc k (point_double_sv p) in
  Nil? (fst (ssub (a0) (b0))) &&
  Nil? (fst (ssub (a1) (b1))) &&
  Nil? (fst (ssub (a2) (b2))) &&
  Nil? (fst (ssub (a3) (b3)))

let dbl_scale_ok (o': fops m0) (env: list (elem m0)) : Lemma (dbl_scale_chk o' env == true) =
  assert (dbl_scale_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let dbl_scale (s x y z t: E.elem)
  : Lemma (ensures pdbl (sc s (x, y, z, t)) == sc (E.fmul (E.fmul s s) (E.fmul s s)) (pdbl (x, y, z, t)))
  = let env = [fromf s; fromf x; fromf y; fromf z; fromf t] in
    dbl_scale_ok o env;
    let c0 = base m0 fl o 5 env in
    o_ok (); base_ok m0 fl o 5 env;
    let c = c0 in
    envf5 c s x y z t;
    o_eqs (); m0_lem (); d_lem (); cst_lem ();
    let b = kc c d2l in
    assert_norm (d2l % m0 == d2l);
    let p = var4 #c 1 2 3 4 in
    let k = smul (smul (svar c 0) (svar c 0)) (smul (svar c 0) (svar c 0)) in
    let (a0, a1, a2, a3) = point_double_sv (ksc (svar c 0) p) in
    let (b0, b1, b2, b3) = ksc k (point_double_sv p) in
    var4_val c 1 2 3 4;
    ksc_val c (svar c 0) p;
    point_double_val c (ksc (svar c 0) p);
    point_double_val c p;
    ksc_val c k (point_double_sv p);
    assert (Nil? (fst (ssub (a0) (b0))));
    sv_eq (a0) (b0);
    assert (Nil? (fst (ssub (a1) (b1))));
    sv_eq (a1) (b1);
    assert (Nil? (fst (ssub (a2) (b2))));
    sv_eq (a2) (b2);
    assert (Nil? (fst (ssub (a3) (b3))));
    sv_eq (a3) (b3);
    ()
#pop-options

(** The addition law is symmetric: an exact identity. *)
let add_comm_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 8 env in
  let c = c0 in
  let b = kc c d2l in
  let p = var4 #c 0 1 2 3 in
  let q = var4 #c 4 5 6 7 in
  let (a0, a1, a2, a3) = point_add_sv b p q in
  let (b0, b1, b2, b3) = point_add_sv b q p in
  Nil? (fst (ssub (a0) (b0))) &&
  Nil? (fst (ssub (a1) (b1))) &&
  Nil? (fst (ssub (a2) (b2))) &&
  Nil? (fst (ssub (a3) (b3)))

let add_comm_ok (o': fops m0) (env: list (elem m0)) : Lemma (add_comm_chk o' env == true) =
  assert (add_comm_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let add_comm (x1 y1 z1 t1 x2 y2 z2 t2: E.elem)
  : Lemma (ensures padd (x1, y1, z1, t1) (x2, y2, z2, t2) == padd (x2, y2, z2, t2) (x1, y1, z1, t1))
  = let env = [fromf x1; fromf y1; fromf z1; fromf t1; fromf x2; fromf y2; fromf z2; fromf t2] in
    add_comm_ok o env;
    let c0 = base m0 fl o 8 env in
    o_ok (); base_ok m0 fl o 8 env;
    let c = c0 in
    envf8 c x1 y1 z1 t1 x2 y2 z2 t2;
    o_eqs (); m0_lem (); d_lem (); cst_lem ();
    let b = kc c d2l in
    assert_norm (d2l % m0 == d2l);
    let p = var4 #c 0 1 2 3 in
    let q = var4 #c 4 5 6 7 in
    let (a0, a1, a2, a3) = point_add_sv b p q in
    let (b0, b1, b2, b3) = point_add_sv b q p in
    var4_val c 0 1 2 3;
    var4_val c 4 5 6 7;
    point_add_val c b p q;
    point_add_val c b q p;
    assert (Nil? (fst (ssub (a0) (b0))));
    sv_eq (a0) (b0);
    assert (Nil? (fst (ssub (a1) (b1))));
    sv_eq (a1) (b1);
    assert (Nil? (fst (ssub (a2) (b2))));
    sv_eq (a2) (b2);
    assert (Nil? (fst (ssub (a3) (b3))));
    sv_eq (a3) (b3);
    ()
#pop-options

(** Adding the identity: the result is proportional to the input. *)
let add_id_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 4 env in
  let c = c0 in
  let b = kc c d2l in
  let p = var4 #c 0 1 2 3 in
  let (a0, a1, a2, _) = point_add_sv b (sinf c) p in
  Nil? (fst (ssub (smul a0 (svar c 2)) (smul (svar c 0) a2))) &&
  Nil? (fst (ssub (smul a1 (svar c 2)) (smul (svar c 1) a2)))

let add_id_ok (o': fops m0) (env: list (elem m0)) : Lemma (add_id_chk o' env == true) =
  assert (add_id_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let add_id (x y z t: E.elem)
  : Lemma (ensures (let (a0, a1, a2, _) = padd Ed.point_at_infinity (x, y, z, t) in E.fmul a0 z == E.fmul x a2 /\ E.fmul a1 z == E.fmul y a2))
  = let env = [fromf x; fromf y; fromf z; fromf t] in
    add_id_ok o env;
    let c0 = base m0 fl o 4 env in
    o_ok (); base_ok m0 fl o 4 env;
    let c = c0 in
    envf4 c x y z t;
    o_eqs (); m0_lem (); d_lem (); cst_lem ();
    let b = kc c d2l in
    assert_norm (d2l % m0 == d2l);
    let p = var4 #c 0 1 2 3 in
    let (a0, a1, a2, _) = point_add_sv b (sinf c) p in
    var4_val c 0 1 2 3;
    sinf_val c;
    point_add_val c b (sinf c) p;
    assert (Nil? (fst (ssub (smul a0 (svar c 2)) (smul (svar c 0) a2))));
    sv_eq (smul a0 (svar c 2)) (smul (svar c 0) a2);
    assert (Nil? (fst (ssub (smul a1 (svar c 2)) (smul (svar c 1) a2))));
    sv_eq (smul a1 (svar c 2)) (smul (svar c 1) a2);
    ()
#pop-options

(** How the curve equation and the invariant scale. *)
let scale_eqs_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 5 env in
  let c = c0 in
  let b = kc c d2l in
  let p = var4 #c 1 2 3 4 in
  let q = ksc (svar c 0) p in
  let (q0, q1, q2, q3) = q in
  let k2 = smul (svar c 0) (svar c 0) in
  let k4 = smul k2 k2 in
  Nil? (fst (ssub (hl_sv q) (smul k4 (hl_sv p)))) &&
  Nil? (fst (ssub (hr_sv q) (smul k4 (hr_sv p)))) &&
  Nil? (fst (ssub (smul q0 q1) (smul k2 (smul (svar c 1) (svar c 2))))) &&
  Nil? (fst (ssub (smul q2 q3) (smul k2 (smul (svar c 3) (svar c 4)))))

let scale_eqs_ok (o': fops m0) (env: list (elem m0)) : Lemma (scale_eqs_chk o' env == true) =
  assert (scale_eqs_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let scale_eqs (s x y z t: E.elem)
  : Lemma (ensures (let (q0, q1, q2, q3) = sc s (x, y, z, t) in let k2 = E.fmul s s in let k4 = E.fmul k2 k2 in hl (sc s (x, y, z, t)) == E.fmul k4 (hl (x, y, z, t)) /\ hr (sc s (x, y, z, t)) == E.fmul k4 (hr (x, y, z, t)) /\ E.fmul q0 q1 == E.fmul k2 (E.fmul x y) /\ E.fmul q2 q3 == E.fmul k2 (E.fmul z t)))
  = let env = [fromf s; fromf x; fromf y; fromf z; fromf t] in
    scale_eqs_ok o env;
    let c0 = base m0 fl o 5 env in
    o_ok (); base_ok m0 fl o 5 env;
    let c = c0 in
    envf5 c s x y z t;
    o_eqs (); m0_lem (); d_lem (); cst_lem ();
    let b = kc c d2l in
    assert_norm (d2l % m0 == d2l);
    let p = var4 #c 1 2 3 4 in
    let q = ksc (svar c 0) p in
    let (q0, q1, q2, q3) = q in
    let k2 = smul (svar c 0) (svar c 0) in
    let k4 = smul k2 k2 in
    var4_val c 1 2 3 4;
    ksc_val c (svar c 0) p;
    eqn_val c p;
    eqn_val c q;
    assert (Nil? (fst (ssub (hl_sv q) (smul k4 (hl_sv p)))));
    sv_eq (hl_sv q) (smul k4 (hl_sv p));
    assert (Nil? (fst (ssub (hr_sv q) (smul k4 (hr_sv p)))));
    sv_eq (hr_sv q) (smul k4 (hr_sv p));
    assert (Nil? (fst (ssub (smul q0 q1) (smul k2 (smul (svar c 1) (svar c 2))))));
    sv_eq (smul q0 q1) (smul k2 (smul (svar c 1) (svar c 2)));
    assert (Nil? (fst (ssub (smul q2 q3) (smul k2 (smul (svar c 3) (svar c 4))))));
    sv_eq (smul q2 q3) (smul k2 (smul (svar c 3) (svar c 4)));
    ()
#pop-options

(** Negation preserves the curve equation and the invariant. *)
let neg_eqs_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 4 env in
  let c = c0 in
  let b = kc c d2l in
  let p = var4 #c 0 1 2 3 in
  let q = sneg p in
  let (q0, _, _, q3) = q in
  Nil? (fst (ssub (smul q0 (svar c 1)) (ssub (kc c 0) (smul (svar c 0) (svar c 1))))) &&
  Nil? (fst (ssub (smul (svar c 2) q3) (ssub (kc c 0) (smul (svar c 2) (svar c 3))))) &&
  Nil? (fst (ssub (hl_sv q) (hl_sv p))) &&
  Nil? (fst (ssub (hr_sv q) (hr_sv p)))

let neg_eqs_ok (o': fops m0) (env: list (elem m0)) : Lemma (neg_eqs_chk o' env == true) =
  assert (neg_eqs_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let neg_eqs (x y z t: E.elem)
  : Lemma (ensures (let (q0, _, _, q3) = pneg (x, y, z, t) in E.fmul q0 y == E.fsub 0 (E.fmul x y) /\ E.fmul z q3 == E.fsub 0 (E.fmul z t) /\ hl (pneg (x, y, z, t)) == hl (x, y, z, t) /\ hr (pneg (x, y, z, t)) == hr (x, y, z, t)))
  = let env = [fromf x; fromf y; fromf z; fromf t] in
    neg_eqs_ok o env;
    let c0 = base m0 fl o 4 env in
    o_ok (); base_ok m0 fl o 4 env;
    let c = c0 in
    envf4 c x y z t;
    o_eqs (); m0_lem (); d_lem (); cst_lem ();
    let b = kc c d2l in
    assert_norm (d2l % m0 == d2l);
    let p = var4 #c 0 1 2 3 in
    let q = sneg p in
    let (q0, _, _, q3) = q in
    var4_val c 0 1 2 3;
    sneg_val c p;
    eqn_val c p;
    eqn_val c q;
    kc_val c 0;
    assert (Nil? (fst (ssub (smul q0 (svar c 1)) (ssub (kc c 0) (smul (svar c 0) (svar c 1))))));
    sv_eq (smul q0 (svar c 1)) (ssub (kc c 0) (smul (svar c 0) (svar c 1)));
    assert (Nil? (fst (ssub (smul (svar c 2) q3) (ssub (kc c 0) (smul (svar c 2) (svar c 3))))));
    sv_eq (smul (svar c 2) q3) (ssub (kc c 0) (smul (svar c 2) (svar c 3)));
    assert (Nil? (fst (ssub (hl_sv q) (hl_sv p))));
    sv_eq (hl_sv q) (hl_sv p);
    assert (Nil? (fst (ssub (hr_sv q) (hr_sv p))));
    sv_eq (hr_sv q) (hr_sv p);
    ()
#pop-options

(** The [Z] of a sum of two affine points is [4 (1 - delta)(1 + delta)]. *)
let add_z_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 4 env in
  let c = c0 in
  let b = kc c d2l in
  let p = aff #c 0 1 in
  let q = aff #c 2 3 in
  let (_, _, rz, _) = point_add_sv b p q in
  let dt = smul (kc c dl) (smul (smul (svar c 0) (svar c 1)) (smul (svar c 2) (svar c 3))) in
  Nil? (fst (ssub (rz) (smul (kc c 4) (smul (ssub (kc c 1) dt) (sadd (kc c 1) dt)))))

let add_z_ok (o': fops m0) (env: list (elem m0)) : Lemma (add_z_chk o' env == true) =
  assert (add_z_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let add_z (u1 v1 u2 v2: E.elem)
  : Lemma (ensures (let (_, _, z, _) = padd (cpt u1 v1) (cpt u2 v2) in let dt = E.fmul Ed.d (E.fmul (E.fmul u1 v1) (E.fmul u2 v2)) in z == E.fmul (cst 4) (E.fmul (E.fsub E.one dt) (E.fadd E.one dt))))
  = let env = [fromf u1; fromf v1; fromf u2; fromf v2] in
    add_z_ok o env;
    let c0 = base m0 fl o 4 env in
    o_ok (); base_ok m0 fl o 4 env;
    let c = c0 in
    envf4 c u1 v1 u2 v2;
    o_eqs (); m0_lem (); d_lem (); cst_lem ();
    let b = kc c d2l in
    assert_norm (d2l % m0 == d2l);
    let p = aff #c 0 1 in
    let q = aff #c 2 3 in
    let (_, _, rz, _) = point_add_sv b p q in
    let dt = smul (kc c dl) (smul (smul (svar c 0) (svar c 1)) (smul (svar c 2) (svar c 3))) in
    aff_val c 0 1;
    aff_val c 2 3;
    point_add_val c b p q;
    kc_val c dl;
    kc_val c 4;
    kc_val c 1;
    assert (Nil? (fst (ssub (rz) (smul (kc c 4) (smul (ssub (kc c 1) dt) (sadd (kc c 1) dt))))));
    sv_eq (rz) (smul (kc c 4) (smul (ssub (kc c 1) dt) (sadd (kc c 1) dt)));
    ()
#pop-options

(** A sum of two affine points satisfies the invariant and the curve equation. *)
let add_on_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 4 env in
  let hs = [aff_hyp c0 0 1; aff_hyp c0 2 3] in
  let c = with_hyps c0 hs in
  let b = kc c d2l in
  let p = aff #c 0 1 in
  let q = aff #c 2 3 in
  let r = point_add_sv b p q in
  let (r0, r1, r2, r3) = r in
  shapes hs &&
  Nil? (fst (ssub (smul r0 r1) (smul r2 r3))) &&
  Nil? (fst (ssub (hl_sv r) (hr_sv r)))

let add_on_ok (o': fops m0) (env: list (elem m0)) : Lemma (add_on_chk o' env == true) =
  assert (add_on_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let add_on_ctx (u1 v1 u2 v2: E.elem)
  : Lemma (requires on u1 v1 /\ on u2 v2)
          (ensures (let env = [fromf u1; fromf v1; fromf u2; fromf v2] in
                    let c0 = base m0 fl o 4 env in
                    let c = with_hyps c0 [aff_hyp c0 0 1; aff_hyp c0 2 3] in
                    ok c /\ c.m == m0 /\ c.o == o /\ c.nv == 4 /\ c.env == env))
  = o_ok (); o_eqs ();
    let env = [fromf u1; fromf v1; fromf u2; fromf v2] in
    let c0 = base m0 fl o 4 env in
    base_ok m0 fl o 4 env;
    envf4 c0 u1 v1 u2 v2;
    aff_hyp_ok c0 0 1;
    aff_hyp_ok c0 2 3;
    holds2 (aff_hyp c0 0 1) (aff_hyp c0 2 3);
    hyps_ok c0 [aff_hyp c0 0 1; aff_hyp c0 2 3]

let add_on (u1 v1 u2 v2: E.elem)
  : Lemma (requires on u1 v1 /\ on u2 v2)
          (ensures (let r = padd (cpt u1 v1) (cpt u2 v2) in let (r0, r1, r2, r3) = r in E.fmul r0 r1 == E.fmul r2 r3 /\ hl r == hr r))
  = let env = [fromf u1; fromf v1; fromf u2; fromf v2] in
    add_on_ok o env;
    let c0 = base m0 fl o 4 env in
    add_on_ctx u1 v1 u2 v2;
    let c = with_hyps c0 [aff_hyp c0 0 1; aff_hyp c0 2 3] in
    envf4 c u1 v1 u2 v2;
    o_eqs (); m0_lem (); d_lem (); cst_lem ();
    let b = kc c d2l in
    assert_norm (d2l % m0 == d2l);
    let p = aff #c 0 1 in
    let q = aff #c 2 3 in
    let r = point_add_sv b p q in
    let (r0, r1, r2, r3) = r in
    aff_val c 0 1;
    aff_val c 2 3;
    point_add_val c b p q;
    eqn_val c r;
    assert (Nil? (fst (ssub (smul r0 r1) (smul r2 r3))));
    sv_eq (smul r0 r1) (smul r2 r3);
    assert (Nil? (fst (ssub (hl_sv r) (hr_sv r))));
    sv_eq (hl_sv r) (hr_sv r);
    ()
#pop-options

(** Doubling an affine point: on the curve, and proportional to adding it to itself. *)
let dbl_aff_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 2 env in
  let hs = [aff_hyp c0 0 1] in
  let c = with_hyps c0 hs in
  let b = kc c d2l in
  let p = aff #c 0 1 in
  let dp = point_double_sv p in
  let (d0, d1, d2, d3) = dp in
  let (s0, s1, s2, _) = point_add_sv b p p in
  shapes hs &&
  Nil? (fst (ssub (smul d0 d1) (smul d2 d3))) &&
  Nil? (fst (ssub (hl_sv dp) (hr_sv dp))) &&
  Nil? (fst (ssub (sadd (smul (kc c 4) d2) s2) (kc c 0))) &&
  Nil? (fst (ssub (smul d0 s2) (smul s0 d2))) &&
  Nil? (fst (ssub (smul d1 s2) (smul s1 d2)))

let dbl_aff_ok (o': fops m0) (env: list (elem m0)) : Lemma (dbl_aff_chk o' env == true) =
  assert (dbl_aff_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let dbl_aff_ctx (u v: E.elem)
  : Lemma (requires on u v)
          (ensures (let env = [fromf u; fromf v] in
                    let c0 = base m0 fl o 2 env in
                    let c = with_hyps c0 [aff_hyp c0 0 1] in
                    ok c /\ c.m == m0 /\ c.o == o /\ c.nv == 2 /\ c.env == env))
  = o_ok (); o_eqs ();
    let env = [fromf u; fromf v] in
    let c0 = base m0 fl o 2 env in
    base_ok m0 fl o 2 env;
    envf2 c0 u v;
    aff_hyp_ok c0 0 1;
    holds1 (aff_hyp c0 0 1);
    hyps_ok c0 [aff_hyp c0 0 1]

let dbl_aff (u v: E.elem)
  : Lemma (requires on u v)
          (ensures (let dp = pdbl (cpt u v) in let (d0, d1, d2, d3) = dp in let (s0, s1, s2, _) = padd (cpt u v) (cpt u v) in E.fmul d0 d1 == E.fmul d2 d3 /\ hl dp == hr dp /\ E.fadd (E.fmul (cst 4) d2) s2 == 0 /\ E.fmul d0 s2 == E.fmul s0 d2 /\ E.fmul d1 s2 == E.fmul s1 d2))
  = let env = [fromf u; fromf v] in
    dbl_aff_ok o env;
    let c0 = base m0 fl o 2 env in
    dbl_aff_ctx u v;
    let c = with_hyps c0 [aff_hyp c0 0 1] in
    envf2 c u v;
    o_eqs (); m0_lem (); d_lem (); cst_lem ();
    let b = kc c d2l in
    assert_norm (d2l % m0 == d2l);
    let p = aff #c 0 1 in
    let dp = point_double_sv p in
    let (d0, d1, d2, d3) = dp in
    let (s0, s1, s2, _) = point_add_sv b p p in
    aff_val c 0 1;
    point_double_val c p;
    point_add_val c b p p;
    eqn_val c dp;
    kc_val c 4;
    kc_val c 0;
    assert (Nil? (fst (ssub (smul d0 d1) (smul d2 d3))));
    sv_eq (smul d0 d1) (smul d2 d3);
    assert (Nil? (fst (ssub (hl_sv dp) (hr_sv dp))));
    sv_eq (hl_sv dp) (hr_sv dp);
    assert (Nil? (fst (ssub (sadd (smul (kc c 4) d2) s2) (kc c 0))));
    sv_eq (sadd (smul (kc c 4) d2) s2) (kc c 0);
    assert (Nil? (fst (ssub (smul d0 s2) (smul s0 d2))));
    sv_eq (smul d0 s2) (smul s0 d2);
    assert (Nil? (fst (ssub (smul d1 s2) (smul s1 d2))));
    sv_eq (smul d1 s2) (smul s1 d2);
    ()
#pop-options

(** Adding an affine point to its negation gives [(0, Y, Y, _)]. *)
let neg_aff_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 2 env in
  let hs = [aff_hyp c0 0 1] in
  let c = with_hyps c0 hs in
  let b = kc c d2l in
  let p = aff #c 0 1 in
  let (n0, n1, n2, _) = point_add_sv b (sneg p) p in
  shapes hs &&
  Nil? (fst (ssub (n0) (kc c 0))) &&
  Nil? (fst (ssub (n1) (n2)))

let neg_aff_ok (o': fops m0) (env: list (elem m0)) : Lemma (neg_aff_chk o' env == true) =
  assert (neg_aff_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let neg_aff_ctx (u v: E.elem)
  : Lemma (requires on u v)
          (ensures (let env = [fromf u; fromf v] in
                    let c0 = base m0 fl o 2 env in
                    let c = with_hyps c0 [aff_hyp c0 0 1] in
                    ok c /\ c.m == m0 /\ c.o == o /\ c.nv == 2 /\ c.env == env))
  = o_ok (); o_eqs ();
    let env = [fromf u; fromf v] in
    let c0 = base m0 fl o 2 env in
    base_ok m0 fl o 2 env;
    envf2 c0 u v;
    aff_hyp_ok c0 0 1;
    holds1 (aff_hyp c0 0 1);
    hyps_ok c0 [aff_hyp c0 0 1]

let neg_aff (u v: E.elem)
  : Lemma (requires on u v)
          (ensures (let (n0, n1, n2, _) = padd (pneg (cpt u v)) (cpt u v) in n0 == 0 /\ n1 == n2))
  = let env = [fromf u; fromf v] in
    neg_aff_ok o env;
    let c0 = base m0 fl o 2 env in
    neg_aff_ctx u v;
    let c = with_hyps c0 [aff_hyp c0 0 1] in
    envf2 c u v;
    o_eqs (); m0_lem (); d_lem (); cst_lem ();
    let b = kc c d2l in
    assert_norm (d2l % m0 == d2l);
    let p = aff #c 0 1 in
    let (n0, n1, n2, _) = point_add_sv b (sneg p) p in
    aff_val c 0 1;
    sneg_val c p;
    point_add_val c b (sneg p) p;
    kc_val c 0;
    assert (Nil? (fst (ssub (n0) (kc c 0))));
    sv_eq (n0) (kc c 0);
    assert (Nil? (fst (ssub (n1) (n2))));
    sv_eq (n1) (n2);
    ()
#pop-options

(** [(i u + v) + (-i u + v) = 2 v]. *)
let iota_sum_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 2 env in
  let c = c0 in
  let b = kc c d2l in
  Nil? (fst (ssub (sadd (sadd (smul (kc c 19681161376707505956807079304988542015446066515923890162744021073123829784752) (svar c 0)) (svar c 1)) (sadd (smul (kc c 38214883241950591754978413199355411911188925816896391856984770930832735035197) (svar c 0)) (svar c 1))) (smul (kc c 2) (svar c 1))))

let iota_sum_ok (o': fops m0) (env: list (elem m0)) : Lemma (iota_sum_chk o' env == true) =
  assert (iota_sum_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let iota_sum (u v: E.elem)
  : Lemma (ensures E.fadd (E.fadd (E.fmul (cst 19681161376707505956807079304988542015446066515923890162744021073123829784752) u) v) (E.fadd (E.fmul (cst 38214883241950591754978413199355411911188925816896391856984770930832735035197) u) v) == E.fmul (cst 2) v)
  = let env = [fromf u; fromf v] in
    iota_sum_ok o env;
    let c0 = base m0 fl o 2 env in
    o_ok (); base_ok m0 fl o 2 env;
    let c = c0 in
    envf2 c u v;
    o_eqs (); m0_lem (); d_lem (); cst_lem ();
    let b = kc c d2l in
    assert_norm (d2l % m0 == d2l);
    kc_val c 19681161376707505956807079304988542015446066515923890162744021073123829784752;
    kc_val c 38214883241950591754978413199355411911188925816896391856984770930832735035197;
    kc_val c 2;
    assert (Nil? (fst (ssub (sadd (sadd (smul (kc c 19681161376707505956807079304988542015446066515923890162744021073123829784752) (svar c 0)) (svar c 1)) (sadd (smul (kc c 38214883241950591754978413199355411911188925816896391856984770930832735035197) (svar c 0)) (svar c 1))) (smul (kc c 2) (svar c 1)))));
    sv_eq (sadd (sadd (smul (kc c 19681161376707505956807079304988542015446066515923890162744021073123829784752) (svar c 0)) (svar c 1)) (sadd (smul (kc c 38214883241950591754978413199355411911188925816896391856984770930832735035197) (svar c 0)) (svar c 1))) (smul (kc c 2) (svar c 1));
    ()
#pop-options

(** Completeness certificate, iota = 19681161376707505956807079304988542015446066515923890162744021073123829784752, epsilon = 1: [d w^2 - v^2] is a multiple of [delta - epsilon]. *)
let comp_pp_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 4 env in
  let hs = [aff_hyp c0 0 1; aff_hyp c0 2 3] in
  let c = with_hyps c0 hs in
  let b = kc c d2l in
  let io = kc c 19681161376707505956807079304988542015446066515923890162744021073123829784752 in
  let ep = kc c 1 in
  let dt = smul (kc c dl) (smul (smul (svar c 0) (svar c 1)) (smul (svar c 2) (svar c 3))) in
  let w = smul (smul (svar c 0) (svar c 1)) (sadd (smul io (svar c 2)) (svar c 3)) in
  let vv = sadd (smul io (svar c 0)) (smul ep (svar c 1)) in
  let k = sadd (sadd dt (smul (kc c 2) (smul (smul (svar c 0) (svar c 1)) io))) ep in
  shapes hs &&
  Nil? (fst (ssub (ssub (smul (kc c dl) (smul w w)) (smul vv vv)) (smul k (ssub dt ep))))

let comp_pp_ok (o': fops m0) (env: list (elem m0)) : Lemma (comp_pp_chk o' env == true) =
  assert (comp_pp_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let comp_pp_ctx (u1 v1 u2 v2: E.elem)
  : Lemma (requires on u1 v1 /\ on u2 v2)
          (ensures (let env = [fromf u1; fromf v1; fromf u2; fromf v2] in
