let comp_pp (u1 v1 u2 v2: E.elem)
  : Lemma (requires on u1 v1 /\ on u2 v2)
          (ensures (let dt = E.fmul Ed.d (E.fmul (E.fmul u1 v1) (E.fmul u2 v2)) in let w = E.fmul (E.fmul u1 v1) (E.fadd (E.fmul (cst 19681161376707505956807079304988542015446066515923890162744021073123829784752) u2) v2) in let vv = E.fadd (E.fmul (cst 19681161376707505956807079304988542015446066515923890162744021073123829784752) u1) (E.fmul (cst 1) v1) in E.fsub (E.fmul Ed.d (E.fmul w w)) (E.fmul vv vv) == E.fmul (E.fadd (E.fadd dt (E.fmul (cst 2) (E.fmul (E.fmul u1 v1) (cst 19681161376707505956807079304988542015446066515923890162744021073123829784752)))) (cst 1)) (E.fsub dt (cst 1))))
