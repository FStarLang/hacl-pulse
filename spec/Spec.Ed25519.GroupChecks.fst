    kc_val c 2;
    assert (Nil? (fst (ssub (ssub (smul (kc c dl) (smul w w)) (smul vv vv)) (smul k (ssub dt ep)))));
    sv_eq (ssub (smul (kc c dl) (smul w w)) (smul vv vv)) (smul k (ssub dt ep));
