(** Polynomial identities behind the P-384 group law.  Each [_chk] is a
    boolean computed by the normaliser (in [_ok]); the lemma of the same
    name reads it back as a statement about [Spec.P384].  Generated by a
    script; the identities themselves were found with a computer-algebra
    system and are merely confirmed here. *)
module Spec.P384.JacChecks

open Spec.Group.Poly
open Spec.Group.Check
open Spec.P384.GroupSv
open Spec.P384.GroupNR
module P = Spec.P384
module Pj = Spec.Group.Proj

open Spec.P384.JacSv
(** Jacobian doubling preserves the Jacobian equation. *)
let j1_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 3 env in
  let hs = [jac_hyp c0 0 1 2] in
  let c = with_hyps c0 hs in
  let b = kc c bl in
  let p = var3 #c 0 1 2 in
  let (rx, ry, rz) = jdouble_sv p in
  shapes hs &&
  Nil? (fst (ssub (smul ry ry) (eqn_rsv (rx, ry, smul rz rz))))

let j1_ok (o': fops m0) (env: list (elem m0)) : Lemma (j1_chk o' env == true) =
  assert (j1_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let j1_ctx (x y z: P.felem)
  : Lemma (requires jeq (x, y, z))
          (ensures (let env = [fromf x; fromf y; fromf z] in
                    let c0 = base m0 fl o 3 env in
                    let c = with_hyps c0 [jac_hyp c0 0 1 2] in
                    ok c /\ c.m == m0 /\ c.o == o /\ c.nv == 3 /\ c.env == env))
  = o_ok (); o_eqs ();
    let env = [fromf x; fromf y; fromf z] in
    let c0 = base m0 fl o 3 env in
    base_ok m0 fl o 3 env;
    envf3 c0 x y z;
    jac_hyp_ok c0 0 1 2;
    holds1 (jac_hyp c0 0 1 2);
    hyps_ok c0 [jac_hyp c0 0 1 2]

let j1 (x y z: P.felem)
  : Lemma (requires jeq (x, y, z))
          (ensures jeq (jdouble (x, y, z)))
  = let env = [fromf x; fromf y; fromf z] in
    j1_ok o env;
    let c0 = base m0 fl o 3 env in
    j1_ctx x y z;
    let c = with_hyps c0 [jac_hyp c0 0 1 2] in
    envf3 c x y z;
    o_eqs (); m0_lem (); bl_lem (); cst_lem (); fneg_lem ();
    let b = kc c bl in
    assert_norm (bl % m0 == bl);
    let p = var3 #c 0 1 2 in
    let (rx, ry, rz) = jdouble_sv p in
    var3_val c 0 1 2;
    jdouble_val c p;
    jeq_val c (rx, ry, rz);
    assert (Nil? (fst (ssub (smul ry ry) (eqn_rsv (rx, ry, smul rz rz)))));
    sv_eq (smul ry ry) (eqn_rsv (rx, ry, smul rz rz));
    ()
#pop-options

(** Jacobian doubling agrees with homogeneous doubling, projectively. *)
let j2_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 3 env in
  let hs = [jac_hyp c0 0 1 2] in
  let c = with_hyps c0 hs in
  let b = kc c bl in
  let p = var3 #c 0 1 2 in
  let (ax, ay, az) = to_h_sv (jdouble_sv p) in
  let (dx, dy, dz) = point_double_sv b (to_h_sv p) in
  shapes hs &&
  Nil? (fst (ssub (smul ax dy) (smul dx ay))) &&
  Nil? (fst (ssub (smul ax dz) (smul dx az))) &&
  Nil? (fst (ssub (smul ay dz) (smul dy az)))

let j2_ok (o': fops m0) (env: list (elem m0)) : Lemma (j2_chk o' env == true) =
  assert (j2_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let j2_ctx (x y z: P.felem)
  : Lemma (requires jeq (x, y, z))
          (ensures (let env = [fromf x; fromf y; fromf z] in
                    let c0 = base m0 fl o 3 env in
                    let c = with_hyps c0 [jac_hyp c0 0 1 2] in
                    ok c /\ c.m == m0 /\ c.o == o /\ c.nv == 3 /\ c.env == env))
  = o_ok (); o_eqs ();
    let env = [fromf x; fromf y; fromf z] in
    let c0 = base m0 fl o 3 env in
    base_ok m0 fl o 3 env;
    envf3 c0 x y z;
    jac_hyp_ok c0 0 1 2;
    holds1 (jac_hyp c0 0 1 2);
    hyps_ok c0 [jac_hyp c0 0 1 2]

let j2 (x y z: P.felem)
  : Lemma (requires jeq (x, y, z))
          (ensures Pj.peq #P.prime (to_h (jdouble (x, y, z))) (P.point_double (to_h (x, y, z))))
  = let env = [fromf x; fromf y; fromf z] in
    j2_ok o env;
    let c0 = base m0 fl o 3 env in
    j2_ctx x y z;
    let c = with_hyps c0 [jac_hyp c0 0 1 2] in
    envf3 c x y z;
    o_eqs (); m0_lem (); bl_lem (); cst_lem (); fneg_lem ();
    let b = kc c bl in
    assert_norm (bl % m0 == bl);
    let p = var3 #c 0 1 2 in
    let (ax, ay, az) = to_h_sv (jdouble_sv p) in
    let (dx, dy, dz) = point_double_sv b (to_h_sv p) in
    var3_val c 0 1 2;
    jdouble_val c p;
    to_h_val c (jdouble_sv p);
    to_h_val c p;
    point_double_val c b (to_h_sv p);
    assert (Nil? (fst (ssub (smul ax dy) (smul dx ay))));
    sv_eq (smul ax dy) (smul dx ay);
    assert (Nil? (fst (ssub (smul ax dz) (smul dx az))));
    sv_eq (smul ax dz) (smul dx az);
    assert (Nil? (fst (ssub (smul ay dz) (smul dy az))));
    sv_eq (smul ay dz) (smul dy az);
    ()
#pop-options

(** A Jacobian point reads as a solution of the homogeneous equation. *)
let j3_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 3 env in
  let hs = [jac_hyp c0 0 1 2] in
  let c = with_hyps c0 hs in
  let b = kc c bl in
  let p = var3 #c 0 1 2 in
  let q = to_h_sv p in
  shapes hs &&
  Nil? (fst (ssub (eqn_lsv q) (eqn_rsv q)))

let j3_ok (o': fops m0) (env: list (elem m0)) : Lemma (j3_chk o' env == true) =
  assert (j3_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let j3_ctx (x y z: P.felem)
  : Lemma (requires jeq (x, y, z))
          (ensures (let env = [fromf x; fromf y; fromf z] in
                    let c0 = base m0 fl o 3 env in
                    let c = with_hyps c0 [jac_hyp c0 0 1 2] in
                    ok c /\ c.m == m0 /\ c.o == o /\ c.nv == 3 /\ c.env == env))
  = o_ok (); o_eqs ();
    let env = [fromf x; fromf y; fromf z] in
    let c0 = base m0 fl o 3 env in
    base_ok m0 fl o 3 env;
    envf3 c0 x y z;
    jac_hyp_ok c0 0 1 2;
    holds1 (jac_hyp c0 0 1 2);
    hyps_ok c0 [jac_hyp c0 0 1 2]

let j3 (x y z: P.felem)
  : Lemma (requires jeq (x, y, z))
          (ensures heq (to_h (x, y, z)))
  = let env = [fromf x; fromf y; fromf z] in
    j3_ok o env;
    let c0 = base m0 fl o 3 env in
    j3_ctx x y z;
    let c = with_hyps c0 [jac_hyp c0 0 1 2] in
    envf3 c x y z;
    o_eqs (); m0_lem (); bl_lem (); cst_lem (); fneg_lem ();
    let b = kc c bl in
    assert_norm (bl % m0 == bl);
    let p = var3 #c 0 1 2 in
    let q = to_h_sv p in
    var3_val c 0 1 2;
    to_h_val c p;
    eqn_val c q;
    FStar.Pervasives.reveal_opaque (`%heq) heq;
    assert (Nil? (fst (ssub (eqn_lsv q) (eqn_rsv q))));
    sv_eq (eqn_lsv q) (eqn_rsv q);
    ()
#pop-options

(** Converting a solution of the homogeneous equation in gives a Jacobian solution. *)
let j4_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 3 env in
  let hs = [hom_hyp c0 0 1 2] in
  let c = with_hyps c0 hs in
  let b = kc c bl in
  let p = var3 #c 0 1 2 in
  let (qx, qy, qz) = tj_sv p in
  shapes hs &&
  Nil? (fst (ssub (smul qy qy) (eqn_rsv (qx, qy, smul qz qz))))

let j4_ok (o': fops m0) (env: list (elem m0)) : Lemma (j4_chk o' env == true) =
  assert (j4_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let j4_ctx (x y z: P.felem)
  : Lemma (requires heq (x, y, z))
          (ensures (let env = [fromf x; fromf y; fromf z] in
                    let c0 = base m0 fl o 3 env in
                    let c = with_hyps c0 [hom_hyp c0 0 1 2] in
                    ok c /\ c.m == m0 /\ c.o == o /\ c.nv == 3 /\ c.env == env))
  = o_ok (); o_eqs ();
    let env = [fromf x; fromf y; fromf z] in
    let c0 = base m0 fl o 3 env in
    base_ok m0 fl o 3 env;
    envf3 c0 x y z;
    hom_hyp_ok c0 0 1 2;
    holds1 (hom_hyp c0 0 1 2);
    hyps_ok c0 [hom_hyp c0 0 1 2]

let j4 (x y z: P.felem)
  : Lemma (requires heq (x, y, z))
          (ensures jeq (tj (x, y, z)))
  = let env = [fromf x; fromf y; fromf z] in
    j4_ok o env;
    let c0 = base m0 fl o 3 env in
    j4_ctx x y z;
    let c = with_hyps c0 [hom_hyp c0 0 1 2] in
    envf3 c x y z;
    o_eqs (); m0_lem (); bl_lem (); cst_lem (); fneg_lem ();
    let b = kc c bl in
    assert_norm (bl % m0 == bl);
    let p = var3 #c 0 1 2 in
    let (qx, qy, qz) = tj_sv p in
    var3_val c 0 1 2;
    tj_val c p;
    jeq_val c (qx, qy, qz);
    assert (Nil? (fst (ssub (smul qy qy) (eqn_rsv (qx, qy, smul qz qz)))));
    sv_eq (smul qy qy) (eqn_rsv (qx, qy, smul qz qz));
    ()
#pop-options

(** Converting in and back out scales by [z^2]: an exact identity. *)
let j5_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 3 env in
  let c = c0 in
  let b = kc c bl in
  let p = var3 #c 0 1 2 in
  let (hx, hy, hz) = to_h_sv (tj_sv p) in
  let (sx, sy, sz) = ksc (smul (svar c 2) (svar c 2)) p in
  Nil? (fst (ssub (hx) (sx))) &&
  Nil? (fst (ssub (hy) (sy))) &&
  Nil? (fst (ssub (hz) (sz)))

let j5_ok (o': fops m0) (env: list (elem m0)) : Lemma (j5_chk o' env == true) =
  assert (j5_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let j5 (x y z: P.felem)
  : Lemma (ensures to_h (tj (x, y, z)) == Pj.scale #P.prime (P.fmul z z) (x, y, z))
  = let env = [fromf x; fromf y; fromf z] in
    j5_ok o env;
    let c0 = base m0 fl o 3 env in
    o_ok (); base_ok m0 fl o 3 env;
    let c = c0 in
    envf3 c x y z;
    o_eqs (); m0_lem (); bl_lem (); cst_lem (); fneg_lem ();
    let b = kc c bl in
    assert_norm (bl % m0 == bl);
    let p = var3 #c 0 1 2 in
    let (hx, hy, hz) = to_h_sv (tj_sv p) in
    let (sx, sy, sz) = ksc (smul (svar c 2) (svar c 2)) p in
    var3_val c 0 1 2;
    tj_val c p;
    to_h_val c (tj_sv p);
    ksc_val c (smul (svar c 2) (svar c 2)) p;
    assert (Nil? (fst (ssub (hx) (sx))));
    sv_eq (hx) (sx);
    assert (Nil? (fst (ssub (hy) (sy))));
    sv_eq (hy) (sy);
    assert (Nil? (fst (ssub (hz) (sz))));
    sv_eq (hz) (sz);
    ()
#pop-options

(** Mixed addition is the addition law at [Z2 = 1]: an exact identity. *)
let j6_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 5 env in
  let c = c0 in
  let b = kc c bl in
  let p = var3 #c 0 1 2 in
  let (mx, my, mz) = madd_sv b p (svar c 3) (svar c 4) in
  let (ax, ay, az) = point_add_sv b p ((svar c 3), (svar c 4), kc c 1) in
  Nil? (fst (ssub (mx) (ax))) &&
  Nil? (fst (ssub (my) (ay))) &&
  Nil? (fst (ssub (mz) (az)))

let j6_ok (o': fops m0) (env: list (elem m0)) : Lemma (j6_chk o' env == true) =
  assert (j6_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let j6 (x1 y1 z1 x2 y2: P.felem)
  : Lemma (ensures madd (x1, y1, z1) x2 y2 == P.point_add (x1, y1, z1) (x2, y2, P.fone))
  = let env = [fromf x1; fromf y1; fromf z1; fromf x2; fromf y2] in
    j6_ok o env;
    let c0 = base m0 fl o 5 env in
    o_ok (); base_ok m0 fl o 5 env;
    let c = c0 in
    envf5 c x1 y1 z1 x2 y2;
    o_eqs (); m0_lem (); bl_lem (); cst_lem (); fneg_lem ();
    let b = kc c bl in
    assert_norm (bl % m0 == bl);
    let p = var3 #c 0 1 2 in
    let (mx, my, mz) = madd_sv b p (svar c 3) (svar c 4) in
    let (ax, ay, az) = point_add_sv b p ((svar c 3), (svar c 4), kc c 1) in
    var3_val c 0 1 2;
    madd_val c b p (svar c 3) (svar c 4);
    point_add_val c b p ((svar c 3), (svar c 4), kc c 1);
    kc_val c 1;
    assert (Nil? (fst (ssub (mx) (ax))));
    sv_eq (mx) (ax);
    assert (Nil? (fst (ssub (my) (ay))));
    sv_eq (my) (ay);
    assert (Nil? (fst (ssub (mz) (az))));
    sv_eq (mz) (az);
    ()
#pop-options
