let tp28_ok (m: nat { m < 9 })
  : Lemma (CB.affine (tp28 m) /\ CB.isq (tp28 m) (m * pow2 224))
  = if m = 0 then tp28_ok0 ()
    else if m = 1 then tp28_ok1 ()
    else if m = 2 then tp28_ok2 ()
    else if m = 3 then tp28_ok3 ()
    else if m = 4 then tp28_ok4 ()
    else if m = 5 then tp28_ok5 ()
    else if m = 6 then tp28_ok6 ()
    else if m = 7 then tp28_ok7 ()
    else (assert (m == 8); tp28_ok8 ())

