ring r = 0, (x1,y1,x2,y2), dp;
proc padd(poly X1, poly Y1, poly Z1, poly X2, poly Y2, poly Z2)
{
  poly b3 = 21;
  poly t0 = X1*X2; poly t1 = Y1*Y2; poly t2 = Z1*Z2; poly t3 = X1+Y1; poly t4 = X2+Y2;
  t3 = t3*t4; t4 = t0+t1; t3 = t3-t4; t4 = Y1+Z1; poly x3 = Y2+Z2; t4 = t4*x3;
  x3 = t1+t2; t4 = t4-x3; x3 = X1+Z1; poly y3 = X2+Z2; x3 = x3*y3; y3 = t0+t2; y3 = x3-y3;
  x3 = t0+t0; t0 = x3+t0; t2 = b3*t2; poly z3 = t1+t2; t1 = t1-t2; y3 = b3*y3;
  x3 = t4*y3; t2 = t3*t1; x3 = t2-x3; y3 = y3*t0; t1 = t1*z3; y3 = t1+y3;
  t0 = t0*t3; z3 = z3*t4; z3 = z3+t0;
  list L = x3,y3,z3; return(L);
}
proc f(poly x) { return(x^3+7); }
list S = padd(x1,y1,1,x2,y2,1);
ideal J = S[1],S[2],S[3], y1^2-f(x1), y2^2-f(x2);
poly D = x1-x2;
poly A = (y1+y2)^2 - (x1+x2)*D^2;
poly G = A^3 + 7*D^6;
ideal Jg = std(J);
"reduce:", reduce(G, Jg);
matrix T = lift(J, G);
print(T[1,1]); print(T[2,1]); print(T[3,1]);
quit;
