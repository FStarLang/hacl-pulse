ring r = 0, (x1,y1,x2,y2,b), dp;
proc padd(poly X1, poly Y1, poly Z1, poly X2, poly Y2, poly Z2)
{
  poly t0 = X1*X2; poly t1 = Y1*Y2; poly t2 = Z1*Z2;
  poly t3 = X1+Y1; poly t4 = X2+Y2; t3 = t3*t4; t4 = t0+t1; t3 = t3-t4;
  t4 = Y1+Z1; poly t5 = Y2+Z2; t4 = t4*t5; t5 = t1+t2; t4 = t4-t5;
  poly X3 = X1+Z1; poly Y3 = X2+Z2; X3 = X3*Y3; Y3 = t0+t2; Y3 = X3-Y3;
  poly Z3 = b*t2; X3 = Y3-Z3; Z3 = X3+X3; X3 = X3+Z3; Z3 = t1-X3; X3 = t1+X3;
  Y3 = b*Y3; t1 = t2+t2; t2 = t1+t2; Y3 = Y3-t2; Y3 = Y3-t0; t1 = Y3+Y3; Y3 = t1+Y3;
  t1 = t0+t0; t0 = t1+t0; t0 = t0-t2; t1 = t4*Y3; t2 = t0*Y3; Y3 = X3*Z3; Y3 = Y3+t2;
  X3 = t3*X3; X3 = X3-t1; Z3 = t4*Z3; t1 = t3*t0; Z3 = Z3+t1;
  list L = X3,Y3,Z3; return(L);
}
proc f(poly x) { return(x^3-3*x+b); }
proc f(poly x) { return(x^3-3*x+b); }
list S = padd(x1,y1,1,x2,y2,1);
ideal J = S[1],S[2],S[3], y1^2-f(x1), y2^2-f(x2);
poly D = x1-x2;
poly A = (y1+y2)^2 - (x1+x2)*D^2;
poly G = A^3 - 3*A*D^4 + b*D^6;
matrix T = lift(J, G);
int i;
print(T[1,1]); print(T[2,1]); print(T[3,1]);
"sizes X3 Y3 Z3:", size(S[1]), size(S[2]), size(S[3]);
"G:", size(G);
quit;
