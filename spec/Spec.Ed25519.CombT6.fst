let tp24 (m: nat { m < 9 }) : ext_point =
  if m = 0 then point_at_infinity
  else if m = 1 then b24
  else if m = 2 then e24_2
  else if m = 3 then e24_3
  else if m = 4 then e24_4
  else if m = 5 then e24_5
  else if m = 6 then e24_6
  else if m = 7 then e24_7
  else e24_8

let tp24_ok0 (_: unit)
  : Lemma (CB.affine (tp24 0) /\ CB.isq (tp24 0) (0 * pow2 192))
  = CB.isq_zero (0 * pow2 192)

let tp24_ok1 (_: unit)
  : Lemma (CB.affine (tp24 1) /\ CB.isq (tp24 1) (1 * pow2 192))
  = bq24_1 ();
    assert (n24 == pow2 192)

let tp24_ok2 (_: unit)
  : Lemma (CB.affine (tp24 2) /\ CB.isq (tp24 2) (2 * pow2 192))
  = e24_2_ok ();
