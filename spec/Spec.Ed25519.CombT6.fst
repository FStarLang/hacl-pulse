    else if m = 3 then tp27_ok3 ()
    else if m = 4 then tp27_ok4 ()
    else if m = 5 then tp27_ok5 ()
    else if m = 6 then tp27_ok6 ()
    else if m = 7 then tp27_ok7 ()
    else (assert (m == 8); tp27_ok8 ())

#pop-options
