let tp24_ok8 (_: unit)
  : Lemma (CB.affine (tp24 8) /\ CB.isq (tp24 8) (8 * pow2 192))
  = e24_8_ok ();
    assert (n24 == pow2 192)

let tp24_ok (m: nat { m < 9 })
  : Lemma (CB.affine (tp24 m) /\ CB.isq (tp24 m) (m * pow2 192))
  = if m = 0 then tp24_ok0 ()
    else if m = 1 then tp24_ok1 ()
    else if m = 2 then tp24_ok2 ()
    else if m = 3 then tp24_ok3 ()
    else if m = 4 then tp24_ok4 ()
    else if m = 5 then tp24_ok5 ()
    else if m = 6 then tp24_ok6 ()
    else if m = 7 then tp24_ok7 ()
    else (assert (m == 8); tp24_ok8 ())

