(** The thirty-two tables of the base-point comb, by index: [tp j m] is
    an affine representative of [m 256^j G].  Generated by
    [spec/group-gen/ed25519/comb.py]; the proofs are in {!Spec.Ed25519.CombT0} and
    its seven siblings. *)
module Spec.Ed25519.CombTable

module SM = Spec.Ed25519.Smul
module CB = Spec.Ed25519.Comb
module T0 = Spec.Ed25519.CombT0
module T1 = Spec.Ed25519.CombT1
module T2 = Spec.Ed25519.CombT2
module T3 = Spec.Ed25519.CombT3
module T4 = Spec.Ed25519.CombT4
module T5 = Spec.Ed25519.CombT5
module T6 = Spec.Ed25519.CombT6
module T7 = Spec.Ed25519.CombT7

open Spec.Ed25519
open Spec.Ed25519.Group

#push-options "--fuel 0 --ifuel 0 --z3rlimit 50"

let tp (j: nat { j < 32 }) (m: nat { m < 9 }) : ext_point =
  if j = 0 then T0.tp0 m
  else if j = 1 then T0.tp1 m
  else if j = 2 then T0.tp2 m
  else if j = 3 then T0.tp3 m
  else if j = 4 then T1.tp4 m
  else if j = 5 then T1.tp5 m
  else if j = 6 then T1.tp6 m
  else if j = 7 then T1.tp7 m
  else if j = 8 then T2.tp8 m
  else if j = 9 then T2.tp9 m
  else if j = 10 then T2.tp10 m
  else if j = 11 then T2.tp11 m
  else if j = 12 then T3.tp12 m
  else if j = 13 then T3.tp13 m
  else if j = 14 then T3.tp14 m
  else if j = 15 then T3.tp15 m
  else if j = 16 then T4.tp16 m
  else if j = 17 then T4.tp17 m
  else if j = 18 then T4.tp18 m
  else if j = 19 then T4.tp19 m
  else if j = 20 then T5.tp20 m
  else if j = 21 then T5.tp21 m
  else if j = 22 then T5.tp22 m
  else if j = 23 then T5.tp23 m
  else if j = 24 then T6.tp24 m
  else if j = 25 then T6.tp25 m
  else if j = 26 then T6.tp26 m
  else if j = 27 then T6.tp27 m
  else if j = 28 then T7.tp28 m
  else if j = 29 then T7.tp29 m
  else if j = 30 then T7.tp30 m
  else T7.tp31 m

let tp_ok (j: nat { j < 32 }) (m: nat { m < 9 })
  : Lemma (CB.affine (tp j m) /\ CB.isq (tp j m) (m * pow2 (8 * j)))
  = if j = 0 then T0.tp0_ok m
    else if j = 1 then T0.tp1_ok m
    else if j = 2 then T0.tp2_ok m
    else if j = 3 then T0.tp3_ok m
    else if j = 4 then T1.tp4_ok m
    else if j = 5 then T1.tp5_ok m
    else if j = 6 then T1.tp6_ok m
    else if j = 7 then T1.tp7_ok m
    else if j = 8 then T2.tp8_ok m
    else if j = 9 then T2.tp9_ok m
    else if j = 10 then T2.tp10_ok m
    else if j = 11 then T2.tp11_ok m
    else if j = 12 then T3.tp12_ok m
    else if j = 13 then T3.tp13_ok m
    else if j = 14 then T3.tp14_ok m
    else if j = 15 then T3.tp15_ok m
    else if j = 16 then T4.tp16_ok m
    else if j = 17 then T4.tp17_ok m
    else if j = 18 then T4.tp18_ok m
    else if j = 19 then T4.tp19_ok m
    else if j = 20 then T5.tp20_ok m
    else if j = 21 then T5.tp21_ok m
    else if j = 22 then T5.tp22_ok m
    else if j = 23 then T5.tp23_ok m
    else if j = 24 then T6.tp24_ok m
    else if j = 25 then T6.tp25_ok m
    else if j = 26 then T6.tp26_ok m
    else if j = 27 then T6.tp27_ok m
    else if j = 28 then T7.tp28_ok m
    else if j = 29 then T7.tp29_ok m
    else if j = 30 then T7.tp30_ok m
    else (assert (j == 31); T7.tp31_ok m)

#pop-options
