let tp20_ok8 (_: unit)
  : Lemma (CB.affine (tp20 8) /\ CB.isq (tp20 8) (8 * pow2 160))
  = e20_8_ok ();
    assert (n20 == pow2 160)

let tp20_ok (m: nat { m < 9 })
  : Lemma (CB.affine (tp20 m) /\ CB.isq (tp20 m) (m * pow2 160))
  = if m = 0 then tp20_ok0 ()
    else if m = 1 then tp20_ok1 ()
    else if m = 2 then tp20_ok2 ()
    else if m = 3 then tp20_ok3 ()
    else if m = 4 then tp20_ok4 ()
    else if m = 5 then tp20_ok5 ()
    else if m = 6 then tp20_ok6 ()
    else if m = 7 then tp20_ok7 ()
    else (assert (m == 8); tp20_ok8 ())

