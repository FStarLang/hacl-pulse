let tp20 (m: nat { m < 9 }) : ext_point =
  if m = 0 then point_at_infinity
  else if m = 1 then b20
  else if m = 2 then e20_2
  else if m = 3 then e20_3
  else if m = 4 then e20_4
  else if m = 5 then e20_5
  else if m = 6 then e20_6
  else if m = 7 then e20_7
  else e20_8

let tp20_ok0 (_: unit)
  : Lemma (CB.affine (tp20 0) /\ CB.isq (tp20 0) (0 * pow2 160))
  = CB.isq_zero (0 * pow2 160)

let tp20_ok1 (_: unit)
  : Lemma (CB.affine (tp20 1) /\ CB.isq (tp20 1) (1 * pow2 160))
  = bq20_1 ();
    assert (n20 == pow2 160)

let tp20_ok2 (_: unit)
  : Lemma (CB.affine (tp20 2) /\ CB.isq (tp20 2) (2 * pow2 160))
  = e20_2_ok ();
