(** Polynomial identities behind the Ed25519 group law.  Each [_chk] is a
    boolean computed by the normaliser (in [_ok]); the lemma of the same
    name reads it back as a statement about [Spec.Ed25519].  Generated by a
    script; the identities themselves were found with a computer-algebra
    system and are merely confirmed here. *)
module Spec.Ed25519.GroupAssoc1

open Spec.Group.Poly
open Spec.Group.Check
open Spec.Ed25519.GroupSv

module E = Spec.Curve25519
module Ed = Spec.Ed25519


(** Associativity, cross product of coordinate 0. *)
let assoc1_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 6 env in
  let hs = [aff_hyp c0 0 1; aff_hyp c0 2 3; aff_hyp c0 4 5] in
  let c = with_hyps c0 hs in
  let b = kc c d2l in
  let a = aff #c 0 1 in
  let bq = aff #c 2 3 in
  let cq = aff #c 4 5 in
  let l = point_add_sv b (point_add_sv b a bq) cq in
  let r = point_add_sv b a (point_add_sv b bq cq) in
  let (l0, _, l2, _) = l in
  let (r0, _, r2, _) = r in
  shapes hs &&
  Nil? (fst (ssub (smul l0 r2) (smul r0 l2)))

let assoc1_ok (o': fops m0) (env: list (elem m0)) : Lemma (assoc1_chk o' env == true) =
  assert (assoc1_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 100"
let assoc1_ctx (u1 v1 u2 v2 u3 v3: E.elem)
  : Lemma (requires on u1 v1 /\ on u2 v2 /\ on u3 v3)
          (ensures (let env = [fromf u1; fromf v1; fromf u2; fromf v2; fromf u3; fromf v3] in
                    let c0 = base m0 fl o 6 env in
                    let c = with_hyps c0 [aff_hyp c0 0 1; aff_hyp c0 2 3; aff_hyp c0 4 5] in
                    ok c /\ c.m == m0 /\ c.o == o /\ c.nv == 6 /\ c.env == env))
  = o_ok (); o_eqs ();
    let env = [fromf u1; fromf v1; fromf u2; fromf v2; fromf u3; fromf v3] in
    let c0 = base m0 fl o 6 env in
    base_ok m0 fl o 6 env;
    envf6 c0 u1 v1 u2 v2 u3 v3;
    aff_hyp_ok c0 0 1;
    aff_hyp_ok c0 2 3;
    aff_hyp_ok c0 4 5;
    holds3 (aff_hyp c0 0 1) (aff_hyp c0 2 3) (aff_hyp c0 4 5);
    hyps_ok c0 [aff_hyp c0 0 1; aff_hyp c0 2 3; aff_hyp c0 4 5]

let assoc1 (u1 v1 u2 v2 u3 v3: E.elem)
  : Lemma (requires on u1 v1 /\ on u2 v2 /\ on u3 v3)
          (ensures (let l = padd (padd (cpt u1 v1) (cpt u2 v2)) (cpt u3 v3) in let r = padd (cpt u1 v1) (padd (cpt u2 v2) (cpt u3 v3)) in let (l0, _, l2, _) = l in let (r0, _, r2, _) = r in E.fmul l0 r2 == E.fmul r0 l2))
  = let env = [fromf u1; fromf v1; fromf u2; fromf v2; fromf u3; fromf v3] in
    assoc1_ok o env;
    let c0 = base m0 fl o 6 env in
    assoc1_ctx u1 v1 u2 v2 u3 v3;
    let c = with_hyps c0 [aff_hyp c0 0 1; aff_hyp c0 2 3; aff_hyp c0 4 5] in
    envf6 c u1 v1 u2 v2 u3 v3;
    o_eqs (); m0_lem (); d_lem (); cst_lem ();
    let b = kc c d2l in
    assert_norm (d2l % m0 == d2l);
    let a = aff #c 0 1 in
    let bq = aff #c 2 3 in
    let cq = aff #c 4 5 in
    let l = point_add_sv b (point_add_sv b a bq) cq in
    let r = point_add_sv b a (point_add_sv b bq cq) in
    let (l0, _, l2, _) = l in
    let (r0, _, r2, _) = r in
    aff_val c 0 1;
    aff_val c 2 3;
    aff_val c 4 5;
    point_add_val c b a bq;
    point_add_val c b (point_add_sv b a bq) cq;
    point_add_val c b bq cq;
    point_add_val c b a (point_add_sv b bq cq);
    assert (Nil? (fst (ssub (smul l0 r2) (smul r0 l2))));
    sv_eq (smul l0 r2) (smul r0 l2);
    ()
#pop-options
