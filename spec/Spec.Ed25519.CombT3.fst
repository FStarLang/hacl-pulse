  : Lemma (CB.affine (tp12 8) /\ CB.isq (tp12 8) (8 * pow2 96))
  = e12_8_ok ();
    assert (n12 == pow2 96)

let tp12_ok (m: nat { m < 9 })
  : Lemma (CB.affine (tp12 m) /\ CB.isq (tp12 m) (m * pow2 96))
  = if m = 0 then tp12_ok0 ()
    else if m = 1 then tp12_ok1 ()
    else if m = 2 then tp12_ok2 ()
    else if m = 3 then tp12_ok3 ()
    else if m = 4 then tp12_ok4 ()
    else if m = 5 then tp12_ok5 ()
    else if m = 6 then tp12_ok6 ()
    else if m = 7 then tp12_ok7 ()
    else (assert (m == 8); tp12_ok8 ())

