let tp12 (m: nat { m < 9 }) : ext_point =
  if m = 0 then point_at_infinity
  else if m = 1 then b12
  else if m = 2 then e12_2
  else if m = 3 then e12_3
  else if m = 4 then e12_4
  else if m = 5 then e12_5
  else if m = 6 then e12_6
  else if m = 7 then e12_7
  else e12_8

let tp12_ok0 (_: unit)
  : Lemma (CB.affine (tp12 0) /\ CB.isq (tp12 0) (0 * pow2 96))
  = CB.isq_zero (0 * pow2 96)

let tp12_ok1 (_: unit)
  : Lemma (CB.affine (tp12 1) /\ CB.isq (tp12 1) (1 * pow2 96))
  = bq12_1 ();
    assert (n12 == pow2 96)

let tp12_ok2 (_: unit)
  : Lemma (CB.affine (tp12 2) /\ CB.isq (tp12 2) (2 * pow2 96))
