    else if m = 2 then tp15_ok2 ()
    else if m = 3 then tp15_ok3 ()
    else if m = 4 then tp15_ok4 ()
    else if m = 5 then tp15_ok5 ()
    else if m = 6 then tp15_ok6 ()
    else if m = 7 then tp15_ok7 ()
    else (assert (m == 8); tp15_ok8 ())

#pop-options
