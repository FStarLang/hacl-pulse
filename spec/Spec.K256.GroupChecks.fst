(** Polynomial identities behind the secp256k1 group law.  Each [_chk] is a
    boolean computed by the normaliser (in [_ok]); the lemma of the same
    name reads it back as a statement about [Spec.K256].  Generated by a
    script; the identities themselves were found with a computer-algebra
    system and are merely confirmed here. *)
module Spec.K256.GroupChecks

open Spec.Group.Poly
open Spec.Group.Check
open Spec.K256.GroupSv
open Spec.K256.GroupNR
module P = Spec.K256
module Pj = Spec.Group.Proj

let cof1 : list (nat & list nat) = [(6, [1; 1; 1; 0]); (18, [1; 0; 1; 1]); (12, [0; 1; 2; 0])]

let cof2 : list (nat & list nat) = [(9, [2; 0; 1; 0]); (115792089237316195423570985008687907853269984665640564039457584007908834671660, [1; 0; 2; 0]); (1, [0; 2; 0; 0]); (12, [0; 1; 0; 1]); (5, [0; 0; 0; 2]); (42, [0; 0; 0; 0])]

let cof3 : list (nat & list nat) = [(115792089237316195423570985008687907853269984665640564039457584007908834671659, [0; 1; 0; 2]); (252, [0; 0; 0; 1])]

(** A linear combination of zeros is zero. *)
#push-options "--fuel 0 --ifuel 0 --z3rlimit 10"
let lin_zero (c: ctx) (k1 k2 k3 x y z: sv c)
  : Lemma (requires ok c /\ c.m == m0 /\ c.o == o)
          (ensures vl x == 0 /\ vl y == 0 /\ vl z == 0 ==>
                   vl (sadd (sadd (smul k1 x) (smul k2 y)) (smul k3 z)) == 0)
  = m0_lem ();
    let mz (a: elem m0) : Lemma (P.fmul a 0 == 0) = () in
    mz (vl k1); mz (vl k2); mz (vl k3);
    assert_norm (P.fadd 0 0 == 0)
#pop-options

(** Completeness: if the sum of two affine points is the zero triple then [G = 0], where [G = D^6 f(A / D^2)]. *)
let k2_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 4 env in
  let hs = [aff_hyp c0 0 1; aff_hyp c0 2 3] in
  let c = with_hyps c0 hs in
  let b = kc c b3l in
  let p = aff #c 0 1 in
  let q = aff #c 2 3 in
  let (rx, ry, rz) = point_add_sv b p q in
  let d = ssub (svar c 0) (svar c 2) in
  let e = smul d d in
  let sa = sadd (svar c 1) (svar c 3) in
  let a = ssub (smul sa sa) (smul (sadd (svar c 0) (svar c 2)) e) in
  let g = eqn_rsv (a, (svar c 1), e) in
  shapes hs &&
  Nil? (fst (ssub (g) (sadd (sadd (smul (spoly cof1) rx) (smul (spoly cof2) ry)) (smul (spoly cof3) rz))))

let k2_ok (o': fops m0) (env: list (elem m0)) : Lemma (k2_chk o' env == true) =
  assert (k2_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let k2_ctx (x1 y1 x2 y2: P.felem)
  : Lemma (requires on x1 y1 /\ on x2 y2)
          (ensures (let env = [fromf x1; fromf y1; fromf x2; fromf y2] in
                    let c0 = base m0 fl o 4 env in
                    let c = with_hyps c0 [aff_hyp c0 0 1; aff_hyp c0 2 3] in
                    ok c /\ c.m == m0 /\ c.o == o /\ c.nv == 4 /\ c.env == env))
  = o_ok (); o_eqs ();
    let env = [fromf x1; fromf y1; fromf x2; fromf y2] in
    let c0 = base m0 fl o 4 env in
    base_ok m0 fl o 4 env;
    envf4 c0 x1 y1 x2 y2;
    aff_hyp_ok c0 0 1;
    aff_hyp_ok c0 2 3;
    holds2 (aff_hyp c0 0 1) (aff_hyp c0 2 3);
    hyps_ok c0 [aff_hyp c0 0 1; aff_hyp c0 2 3]

let k2 (x1 y1 x2 y2: P.felem)
  : Lemma (requires on x1 y1 /\ on x2 y2)
          (ensures (let (x3, y3, z3) = P.point_add (x1, y1, P.fone) (x2, y2, P.fone) in let d = P.fsub x1 x2 in let sa = P.fadd y1 y2 in x3 == 0 /\ y3 == 0 /\ z3 == 0 ==> eqn_r (P.fsub (P.fmul sa sa) (P.fmul (P.fadd x1 x2) (P.fmul d d)), y1, P.fmul d d) == 0))
  = let env = [fromf x1; fromf y1; fromf x2; fromf y2] in
    k2_ok o env;
    let c0 = base m0 fl o 4 env in
    k2_ctx x1 y1 x2 y2;
    let c = with_hyps c0 [aff_hyp c0 0 1; aff_hyp c0 2 3] in
    envf4 c x1 y1 x2 y2;
    o_eqs (); m0_lem (); bl_lem (); cst_lem (); fneg_lem ();
    let b = kc c b3l in
    assert_norm (b3l % m0 == b3l);
    let p = aff #c 0 1 in
    let q = aff #c 2 3 in
    let (rx, ry, rz) = point_add_sv b p q in
    let d = ssub (svar c 0) (svar c 2) in
    let e = smul d d in
    let sa = sadd (svar c 1) (svar c 3) in
    let a = ssub (smul sa sa) (smul (sadd (svar c 0) (svar c 2)) e) in
    let g = eqn_rsv (a, (svar c 1), e) in
    aff_val c 0 1;
    aff_val c 2 3;
    point_add_val c b p q;
    eqn_val c (a, (svar c 1), e);
    assert (Nil? (fst (ssub (g) (sadd (sadd (smul (spoly cof1) rx) (smul (spoly cof2) ry)) (smul (spoly cof3) rz)))));
    sv_eq (g) (sadd (sadd (smul (spoly cof1) rx) (smul (spoly cof2) ry)) (smul (spoly cof3) rz));
    let dd = P.fsub x1 x2 in
    let ssa = P.fadd y1 y2 in
    assert (tof (vl d) == dd);
    assert (tof (vl e) == P.fmul dd dd);
    assert (tof (vl sa) == ssa);
    assert (tof (vl a) == P.fsub (P.fmul ssa ssa) (P.fmul (P.fadd x1 x2) (P.fmul dd dd)));
    assert (tof3 (a, (svar c 1), e) == (P.fsub (P.fmul ssa ssa) (P.fmul (P.fadd x1 x2) (P.fmul dd dd)), y1, P.fmul dd dd));
    assert (tof (vl g) == eqn_r (P.fsub (P.fmul ssa ssa) (P.fmul (P.fadd x1 x2) (P.fmul dd dd)), y1, P.fmul dd dd));
    assert (tof3 (rx, ry, rz) == P.point_add (x1, y1, P.fone) (x2, y2, P.fone));
    lin_zero c (spoly cof1) (spoly cof2) (spoly cof3) rx ry rz;
    ()
#pop-options

(** Affine points add to a point satisfying the homogeneous equation. *)
let k1_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 4 env in
  let hs = [aff_hyp c0 0 1; aff_hyp c0 2 3] in
  let c = with_hyps c0 hs in
  let b = kc c b3l in
  let p = aff #c 0 1 in
  let q = aff #c 2 3 in
  let r = point_add_sv b p q in
  shapes hs &&
  Nil? (fst (ssub (eqn_lsv r) (eqn_rsv r)))

let k1_ok (o': fops m0) (env: list (elem m0)) : Lemma (k1_chk o' env == true) =
  assert (k1_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let k1_ctx (x1 y1 x2 y2: P.felem)
  : Lemma (requires on x1 y1 /\ on x2 y2)
          (ensures (let env = [fromf x1; fromf y1; fromf x2; fromf y2] in
                    let c0 = base m0 fl o 4 env in
                    let c = with_hyps c0 [aff_hyp c0 0 1; aff_hyp c0 2 3] in
                    ok c /\ c.m == m0 /\ c.o == o /\ c.nv == 4 /\ c.env == env))
  = o_ok (); o_eqs ();
    let env = [fromf x1; fromf y1; fromf x2; fromf y2] in
    let c0 = base m0 fl o 4 env in
    base_ok m0 fl o 4 env;
    envf4 c0 x1 y1 x2 y2;
    aff_hyp_ok c0 0 1;
    aff_hyp_ok c0 2 3;
    holds2 (aff_hyp c0 0 1) (aff_hyp c0 2 3);
    hyps_ok c0 [aff_hyp c0 0 1; aff_hyp c0 2 3]

let k1 (x1 y1 x2 y2: P.felem)
  : Lemma (requires on x1 y1 /\ on x2 y2)
          (ensures heq (P.point_add (x1, y1, P.fone) (x2, y2, P.fone)))
  = let env = [fromf x1; fromf y1; fromf x2; fromf y2] in
    k1_ok o env;
    let c0 = base m0 fl o 4 env in
    k1_ctx x1 y1 x2 y2;
    let c = with_hyps c0 [aff_hyp c0 0 1; aff_hyp c0 2 3] in
    envf4 c x1 y1 x2 y2;
    o_eqs (); m0_lem (); bl_lem (); cst_lem (); fneg_lem ();
    let b = kc c b3l in
    assert_norm (b3l % m0 == b3l);
    let p = aff #c 0 1 in
    let q = aff #c 2 3 in
    let r = point_add_sv b p q in
    aff_val c 0 1;
    aff_val c 2 3;
    point_add_val c b p q;
    eqn_val c r;
    FStar.Pervasives.reveal_opaque (`%heq) heq;
    assert (Nil? (fst (ssub (eqn_lsv r) (eqn_rsv r))));
    sv_eq (eqn_lsv r) (eqn_rsv r);
    ()
#pop-options

(** Doubling an affine point by addition: [Z3 = 8 y^3]. *)
let k4_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 2 env in
  let hs = [aff_hyp c0 0 1] in
  let c = with_hyps c0 hs in
  let b = kc c b3l in
  let p = aff #c 0 1 in
  let (_, _, z3) = point_add_sv b p p in
  shapes hs &&
  Nil? (fst (ssub (z3) (smul (kc c 8) (smul (smul (svar c 1) (svar c 1)) (svar c 1)))))

let k4_ok (o': fops m0) (env: list (elem m0)) : Lemma (k4_chk o' env == true) =
  assert (k4_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let k4_ctx (x y: P.felem)
  : Lemma (requires on x y)
          (ensures (let env = [fromf x; fromf y] in
                    let c0 = base m0 fl o 2 env in
                    let c = with_hyps c0 [aff_hyp c0 0 1] in
                    ok c /\ c.m == m0 /\ c.o == o /\ c.nv == 2 /\ c.env == env))
  = o_ok (); o_eqs ();
    let env = [fromf x; fromf y] in
    let c0 = base m0 fl o 2 env in
    base_ok m0 fl o 2 env;
    envf2 c0 x y;
    aff_hyp_ok c0 0 1;
    holds1 (aff_hyp c0 0 1);
    hyps_ok c0 [aff_hyp c0 0 1]

let k4 (x y: P.felem)
  : Lemma (requires on x y)
          (ensures (let (_, _, z) = P.point_add (x, y, P.fone) (x, y, P.fone) in z == P.fmul (cst 8) (P.fmul (P.fmul y y) y)))
  = let env = [fromf x; fromf y] in
    k4_ok o env;
    let c0 = base m0 fl o 2 env in
    k4_ctx x y;
    let c = with_hyps c0 [aff_hyp c0 0 1] in
    envf2 c x y;
    o_eqs (); m0_lem (); bl_lem (); cst_lem (); fneg_lem ();
    let b = kc c b3l in
    assert_norm (b3l % m0 == b3l);
    let p = aff #c 0 1 in
    let (_, _, z3) = point_add_sv b p p in
    aff_val c 0 1;
    point_add_val c b p p;
    kc_val c 8;
    assert (Nil? (fst (ssub (z3) (smul (kc c 8) (smul (smul (svar c 1) (svar c 1)) (svar c 1))))));
    sv_eq (z3) (smul (kc c 8) (smul (smul (svar c 1) (svar c 1)) (svar c 1)));
    ()
#pop-options

(** Adding an affine point to its negation: [Y3 = Q(x)]. *)
let k5_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 2 env in
  let hs = [aff_hyp c0 0 1] in
  let c = with_hyps c0 hs in
  let b = kc c b3l in
  let p = aff #c 0 1 in
  let (_, y3, _) = point_add_sv b p (sneg p) in
  shapes hs &&
  Nil? (fst (ssub (y3) (qb c (svar c 0))))

let k5_ok (o': fops m0) (env: list (elem m0)) : Lemma (k5_chk o' env == true) =
  assert (k5_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let k5_ctx (x y: P.felem)
  : Lemma (requires on x y)
          (ensures (let env = [fromf x; fromf y] in
                    let c0 = base m0 fl o 2 env in
                    let c = with_hyps c0 [aff_hyp c0 0 1] in
                    ok c /\ c.m == m0 /\ c.o == o /\ c.nv == 2 /\ c.env == env))
  = o_ok (); o_eqs ();
    let env = [fromf x; fromf y] in
    let c0 = base m0 fl o 2 env in
    base_ok m0 fl o 2 env;
    envf2 c0 x y;
    aff_hyp_ok c0 0 1;
    holds1 (aff_hyp c0 0 1);
    hyps_ok c0 [aff_hyp c0 0 1]

let k5 (x y: P.felem)
  : Lemma (requires on x y)
          (ensures (let (_, y3, _) = P.point_add (x, y, P.fone) (P.point_negate (x, y, P.fone)) in y3 == fq x))
  = let env = [fromf x; fromf y] in
    k5_ok o env;
    let c0 = base m0 fl o 2 env in
    k5_ctx x y;
    let c = with_hyps c0 [aff_hyp c0 0 1] in
    envf2 c x y;
    o_eqs (); m0_lem (); bl_lem (); cst_lem (); fneg_lem ();
    let b = kc c b3l in
    assert_norm (b3l % m0 == b3l);
    let p = aff #c 0 1 in
    let (_, y3, _) = point_add_sv b p (sneg p) in
    aff_val c 0 1;
    sneg_val c p;
    point_add_val c b p (sneg p);
    qb_val c (svar c 0);
    assert (Nil? (fst (ssub (y3) (qb c (svar c 0)))));
    sv_eq (y3) (qb c (svar c 0));
    ()
#pop-options

(** The right-hand side at [(u e, _, e)] is [e^3 f(u)]. *)
let k6_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 3 env in
  let c = c0 in
  let b = kc c b3l in
  let a = smul (svar c 0) (svar c 1) in
  Nil? (fst (ssub (eqn_rsv (a, (svar c 2), (svar c 1))) (smul (smul (smul (svar c 1) (svar c 1)) (svar c 1)) (crv c (svar c 0)))))

let k6_ok (o': fops m0) (env: list (elem m0)) : Lemma (k6_chk o' env == true) =
  assert (k6_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let k6 (u e y: P.felem)
  : Lemma (ensures eqn_r (P.fmul u e, y, e) == P.fmul (P.fmul (P.fmul e e) e) (ff u))
  = let env = [fromf u; fromf e; fromf y] in
    k6_ok o env;
    let c0 = base m0 fl o 3 env in
    o_ok (); base_ok m0 fl o 3 env;
    let c = c0 in
    envf3 c u e y;
    o_eqs (); m0_lem (); bl_lem (); cst_lem (); fneg_lem ();
    let b = kc c b3l in
    assert_norm (b3l % m0 == b3l);
    let a = smul (svar c 0) (svar c 1) in
    eqn_val c (a, (svar c 2), (svar c 1));
    crv_val c (svar c 0);
    assert (Nil? (fst (ssub (eqn_rsv (a, (svar c 2), (svar c 1))) (smul (smul (smul (svar c 1) (svar c 1)) (svar c 1)) (crv c (svar c 0))))));
    sv_eq (eqn_rsv (a, (svar c 2), (svar c 1))) (smul (smul (smul (svar c 1) (svar c 1)) (svar c 1)) (crv c (svar c 0)));
    ()
#pop-options

(** Two points with the same [x]: [(y2 - y1)(y2 + y1) = 0]. *)
let k7_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 3 env in
  let hs = [aff_hyp c0 0 1; aff_hyp c0 0 2] in
  let c = with_hyps c0 hs in
  let b = kc c b3l in
  shapes hs &&
  Nil? (fst (ssub (smul (ssub (svar c 2) (svar c 1)) (sadd (svar c 2) (svar c 1))) (kc c 0)))

let k7_ok (o': fops m0) (env: list (elem m0)) : Lemma (k7_chk o' env == true) =
  assert (k7_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let k7_ctx (x y1 y2: P.felem)
  : Lemma (requires on x y1 /\ on x y2)
          (ensures (let env = [fromf x; fromf y1; fromf y2] in
                    let c0 = base m0 fl o 3 env in
                    let c = with_hyps c0 [aff_hyp c0 0 1; aff_hyp c0 0 2] in
                    ok c /\ c.m == m0 /\ c.o == o /\ c.nv == 3 /\ c.env == env))
  = o_ok (); o_eqs ();
    let env = [fromf x; fromf y1; fromf y2] in
    let c0 = base m0 fl o 3 env in
    base_ok m0 fl o 3 env;
    envf3 c0 x y1 y2;
    aff_hyp_ok c0 0 1;
    aff_hyp_ok c0 0 2;
    holds2 (aff_hyp c0 0 1) (aff_hyp c0 0 2);
    hyps_ok c0 [aff_hyp c0 0 1; aff_hyp c0 0 2]

let k7 (x y1 y2: P.felem)
  : Lemma (requires on x y1 /\ on x y2)
          (ensures P.fmul (P.fsub y2 y1) (P.fadd y2 y1) == 0)
  = let env = [fromf x; fromf y1; fromf y2] in
    k7_ok o env;
    let c0 = base m0 fl o 3 env in
    k7_ctx x y1 y2;
    let c = with_hyps c0 [aff_hyp c0 0 1; aff_hyp c0 0 2] in
    envf3 c x y1 y2;
    o_eqs (); m0_lem (); bl_lem (); cst_lem (); fneg_lem ();
    let b = kc c b3l in
    assert_norm (b3l % m0 == b3l);
    kc_val c 0;
    assert (Nil? (fst (ssub (smul (ssub (svar c 2) (svar c 1)) (sadd (svar c 2) (svar c 1))) (kc c 0))));
    sv_eq (smul (ssub (svar c 2) (svar c 1)) (sadd (svar c 2) (svar c 1))) (kc c 0);
    ()
#pop-options

(** Adding infinity scales by [Y]: an exact identity. *)
let k8_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 3 env in
  let c = c0 in
  let b = kc c b3l in
  let p = var3 #c 0 1 2 in
  let (rx, ry, rz) = point_add_sv b (sinf c) p in
  Nil? (fst (ssub (rx) (smul (svar c 1) (svar c 0)))) &&
  Nil? (fst (ssub (ry) (smul (svar c 1) (svar c 1)))) &&
  Nil? (fst (ssub (rz) (smul (svar c 1) (svar c 2))))

let k8_ok (o': fops m0) (env: list (elem m0)) : Lemma (k8_chk o' env == true) =
  assert (k8_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let k8 (x y z: P.felem)
  : Lemma (ensures P.point_add P.point_at_infinity (x, y, z) == Pj.scale #P.prime y (x, y, z))
  = let env = [fromf x; fromf y; fromf z] in
    k8_ok o env;
    let c0 = base m0 fl o 3 env in
    o_ok (); base_ok m0 fl o 3 env;
    let c = c0 in
    envf3 c x y z;
    o_eqs (); m0_lem (); bl_lem (); cst_lem (); fneg_lem ();
    let b = kc c b3l in
    assert_norm (b3l % m0 == b3l);
    let p = var3 #c 0 1 2 in
    let (rx, ry, rz) = point_add_sv b (sinf c) p in
    var3_val c 0 1 2;
    sinf_val c;
    point_add_val c b (sinf c) p;
    assert (Nil? (fst (ssub (rx) (smul (svar c 1) (svar c 0)))));
    sv_eq (rx) (smul (svar c 1) (svar c 0));
    assert (Nil? (fst (ssub (ry) (smul (svar c 1) (svar c 1)))));
    sv_eq (ry) (smul (svar c 1) (svar c 1));
    assert (Nil? (fst (ssub (rz) (smul (svar c 1) (svar c 2)))));
    sv_eq (rz) (smul (svar c 1) (svar c 2));
    ()
#pop-options

(** The addition law is symmetric: an exact identity. *)
let k9_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 6 env in
  let c = c0 in
  let b = kc c b3l in
  let p = var3 #c 0 1 2 in
  let q = var3 #c 3 4 5 in
  let (ux, uy, uz) = point_add_sv b p q in
  let (vx, vy, vz) = point_add_sv b q p in
  Nil? (fst (ssub (ux) (vx))) &&
  Nil? (fst (ssub (uy) (vy))) &&
  Nil? (fst (ssub (uz) (vz)))

let k9_ok (o': fops m0) (env: list (elem m0)) : Lemma (k9_chk o' env == true) =
  assert (k9_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let k9 (x1 y1 z1 x2 y2 z2: P.felem)
  : Lemma (ensures P.point_add (x1, y1, z1) (x2, y2, z2) == P.point_add (x2, y2, z2) (x1, y1, z1))
  = let env = [fromf x1; fromf y1; fromf z1; fromf x2; fromf y2; fromf z2] in
    k9_ok o env;
    let c0 = base m0 fl o 6 env in
    o_ok (); base_ok m0 fl o 6 env;
    let c = c0 in
    envf6 c x1 y1 z1 x2 y2 z2;
    o_eqs (); m0_lem (); bl_lem (); cst_lem (); fneg_lem ();
    let b = kc c b3l in
    assert_norm (b3l % m0 == b3l);
    let p = var3 #c 0 1 2 in
    let q = var3 #c 3 4 5 in
    let (ux, uy, uz) = point_add_sv b p q in
    let (vx, vy, vz) = point_add_sv b q p in
    var3_val c 0 1 2;
    var3_val c 3 4 5;
    point_add_val c b p q;
    point_add_val c b q p;
    assert (Nil? (fst (ssub (ux) (vx))));
    sv_eq (ux) (vx);
    assert (Nil? (fst (ssub (uy) (vy))));
    sv_eq (uy) (vy);
    assert (Nil? (fst (ssub (uz) (vz))));
    sv_eq (uz) (vz);
    ()
#pop-options

(** Doubling agrees with adding a point to itself, projectively. *)
let k10_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 3 env in
  let hs = [hom_hyp c0 0 1 2] in
  let c = with_hyps c0 hs in
  let b = kc c b3l in
  let p = var3 #c 0 1 2 in
  let (dx, dy, dz) = point_double_sv b p in
  let (ax, ay, az) = point_add_sv b p p in
  shapes hs &&
  Nil? (fst (ssub (smul dx ay) (smul ax dy))) &&
  Nil? (fst (ssub (smul dx az) (smul ax dz))) &&
  Nil? (fst (ssub (smul dy az) (smul ay dz)))

let k10_ok (o': fops m0) (env: list (elem m0)) : Lemma (k10_chk o' env == true) =
  assert (k10_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let k10_ctx (x y z: P.felem)
  : Lemma (requires heq (x, y, z))
          (ensures (let env = [fromf x; fromf y; fromf z] in
                    let c0 = base m0 fl o 3 env in
                    let c = with_hyps c0 [hom_hyp c0 0 1 2] in
                    ok c /\ c.m == m0 /\ c.o == o /\ c.nv == 3 /\ c.env == env))
  = o_ok (); o_eqs ();
    let env = [fromf x; fromf y; fromf z] in
    let c0 = base m0 fl o 3 env in
    base_ok m0 fl o 3 env;
    envf3 c0 x y z;
    hom_hyp_ok c0 0 1 2;
    holds1 (hom_hyp c0 0 1 2);
    hyps_ok c0 [hom_hyp c0 0 1 2]

let k10 (x y z: P.felem)
  : Lemma (requires heq (x, y, z))
          (ensures Pj.peq #P.prime (P.point_double (x, y, z)) (P.point_add (x, y, z) (x, y, z)))
  = let env = [fromf x; fromf y; fromf z] in
    k10_ok o env;
    let c0 = base m0 fl o 3 env in
    k10_ctx x y z;
    let c = with_hyps c0 [hom_hyp c0 0 1 2] in
    envf3 c x y z;
    o_eqs (); m0_lem (); bl_lem (); cst_lem (); fneg_lem ();
    let b = kc c b3l in
    assert_norm (b3l % m0 == b3l);
    let p = var3 #c 0 1 2 in
    let (dx, dy, dz) = point_double_sv b p in
    let (ax, ay, az) = point_add_sv b p p in
    var3_val c 0 1 2;
    point_double_val c b p;
    point_add_val c b p p;
    assert (Nil? (fst (ssub (smul dx ay) (smul ax dy))));
    sv_eq (smul dx ay) (smul ax dy);
    assert (Nil? (fst (ssub (smul dx az) (smul ax dz))));
    sv_eq (smul dx az) (smul ax dz);
    assert (Nil? (fst (ssub (smul dy az) (smul ay dz))));
    sv_eq (smul dy az) (smul ay dz);
    ()
#pop-options

(** Doubling preserves the homogeneous equation. *)
let k11_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 3 env in
  let hs = [hom_hyp c0 0 1 2] in
  let c = with_hyps c0 hs in
  let b = kc c b3l in
  let p = var3 #c 0 1 2 in
  let r = point_double_sv b p in
  shapes hs &&
  Nil? (fst (ssub (eqn_lsv r) (eqn_rsv r)))

let k11_ok (o': fops m0) (env: list (elem m0)) : Lemma (k11_chk o' env == true) =
  assert (k11_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let k11_ctx (x y z: P.felem)
  : Lemma (requires heq (x, y, z))
          (ensures (let env = [fromf x; fromf y; fromf z] in
                    let c0 = base m0 fl o 3 env in
                    let c = with_hyps c0 [hom_hyp c0 0 1 2] in
                    ok c /\ c.m == m0 /\ c.o == o /\ c.nv == 3 /\ c.env == env))
  = o_ok (); o_eqs ();
    let env = [fromf x; fromf y; fromf z] in
    let c0 = base m0 fl o 3 env in
    base_ok m0 fl o 3 env;
    envf3 c0 x y z;
    hom_hyp_ok c0 0 1 2;
    holds1 (hom_hyp c0 0 1 2);
    hyps_ok c0 [hom_hyp c0 0 1 2]

let k11 (x y z: P.felem)
  : Lemma (requires heq (x, y, z))
          (ensures heq (P.point_double (x, y, z)))
  = let env = [fromf x; fromf y; fromf z] in
    k11_ok o env;
    let c0 = base m0 fl o 3 env in
    k11_ctx x y z;
    let c = with_hyps c0 [hom_hyp c0 0 1 2] in
    envf3 c x y z;
    o_eqs (); m0_lem (); bl_lem (); cst_lem (); fneg_lem ();
    let b = kc c b3l in
    assert_norm (b3l % m0 == b3l);
    let p = var3 #c 0 1 2 in
    let r = point_double_sv b p in
    var3_val c 0 1 2;
    point_double_val c b p;
    eqn_val c r;
    FStar.Pervasives.reveal_opaque (`%heq) heq;
    assert (Nil? (fst (ssub (eqn_lsv r) (eqn_rsv r))));
    sv_eq (eqn_lsv r) (eqn_rsv r);
    ()
#pop-options

(** The addition law is homogeneous of degree two in each argument. *)
let k12_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 8 env in
  let c = c0 in
  let b = kc c b3l in
  let ss = svar c 0 in
  let st = svar c 1 in
  let p = var3 #c 2 3 4 in
  let q = var3 #c 5 6 7 in
  let k = smul (smul ss ss) (smul st st) in
  let (lx, ly, lz) = point_add_sv b (ksc ss p) (ksc st q) in
  let (rx, ry, rz) = ksc k (point_add_sv b p q) in
  Nil? (fst (ssub (lx) (rx))) &&
  Nil? (fst (ssub (ly) (ry))) &&
  Nil? (fst (ssub (lz) (rz)))

let k12_ok (o': fops m0) (env: list (elem m0)) : Lemma (k12_chk o' env == true) =
  assert (k12_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let k12 (s t x1 y1 z1 x2 y2 z2: P.felem)
  : Lemma (ensures P.point_add (Pj.scale #P.prime s (x1, y1, z1)) (Pj.scale #P.prime t (x2, y2, z2)) == Pj.scale #P.prime (P.fmul (P.fmul s s) (P.fmul t t)) (P.point_add (x1, y1, z1) (x2, y2, z2)))
  = let env = [fromf s; fromf t; fromf x1; fromf y1; fromf z1; fromf x2; fromf y2; fromf z2] in
    k12_ok o env;
    let c0 = base m0 fl o 8 env in
    o_ok (); base_ok m0 fl o 8 env;
    let c = c0 in
    envf8 c s t x1 y1 z1 x2 y2 z2;
    o_eqs (); m0_lem (); bl_lem (); cst_lem (); fneg_lem ();
    let b = kc c b3l in
    assert_norm (b3l % m0 == b3l);
    let ss = svar c 0 in
    let st = svar c 1 in
    let p = var3 #c 2 3 4 in
    let q = var3 #c 5 6 7 in
    let k = smul (smul ss ss) (smul st st) in
    let (lx, ly, lz) = point_add_sv b (ksc ss p) (ksc st q) in
    let (rx, ry, rz) = ksc k (point_add_sv b p q) in
    var3_val c 2 3 4;
    var3_val c 5 6 7;
    ksc_val c ss p;
    ksc_val c st q;
    point_add_val c b (ksc ss p) (ksc st q);
    point_add_val c b p q;
    ksc_val c k (point_add_sv b p q);
    assert (Nil? (fst (ssub (lx) (rx))));
    sv_eq (lx) (rx);
    assert (Nil? (fst (ssub (ly) (ry))));
    sv_eq (ly) (ry);
    assert (Nil? (fst (ssub (lz) (rz))));
    sv_eq (lz) (rz);
    ()
#pop-options

(** A point plus its negation has [X = Z = 0]. *)
let k14_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 3 env in
  let hs = [hom_hyp c0 0 1 2] in
  let c = with_hyps c0 hs in
  let b = kc c b3l in
  let p = var3 #c 0 1 2 in
  let (nx, _, nz) = point_add_sv b (sneg p) p in
  shapes hs &&
  Nil? (fst (ssub (nx) (kc c 0))) &&
  Nil? (fst (ssub (nz) (kc c 0)))

let k14_ok (o': fops m0) (env: list (elem m0)) : Lemma (k14_chk o' env == true) =
  assert (k14_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let k14_ctx (x y z: P.felem)
  : Lemma (requires heq (x, y, z))
          (ensures (let env = [fromf x; fromf y; fromf z] in
                    let c0 = base m0 fl o 3 env in
                    let c = with_hyps c0 [hom_hyp c0 0 1 2] in
                    ok c /\ c.m == m0 /\ c.o == o /\ c.nv == 3 /\ c.env == env))
  = o_ok (); o_eqs ();
    let env = [fromf x; fromf y; fromf z] in
    let c0 = base m0 fl o 3 env in
    base_ok m0 fl o 3 env;
    envf3 c0 x y z;
    hom_hyp_ok c0 0 1 2;
    holds1 (hom_hyp c0 0 1 2);
    hyps_ok c0 [hom_hyp c0 0 1 2]

let k14 (x y z: P.felem)
  : Lemma (requires heq (x, y, z))
          (ensures (let (x3, _, z3) = P.point_add (P.point_negate (x, y, z)) (x, y, z) in x3 == 0 /\ z3 == 0))
  = let env = [fromf x; fromf y; fromf z] in
    k14_ok o env;
    let c0 = base m0 fl o 3 env in
    k14_ctx x y z;
    let c = with_hyps c0 [hom_hyp c0 0 1 2] in
    envf3 c x y z;
    o_eqs (); m0_lem (); bl_lem (); cst_lem (); fneg_lem ();
    let b = kc c b3l in
    assert_norm (b3l % m0 == b3l);
    let p = var3 #c 0 1 2 in
    let (nx, _, nz) = point_add_sv b (sneg p) p in
    var3_val c 0 1 2;
    sneg_val c p;
    point_add_val c b (sneg p) p;
    kc_val c 0;
    assert (Nil? (fst (ssub (nx) (kc c 0))));
    sv_eq (nx) (kc c 0);
    assert (Nil? (fst (ssub (nz) (kc c 0))));
    sv_eq (nz) (kc c 0);
    ()
#pop-options

(** The [Z] of a double is [8 y^3 z]. *)
let k15_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 3 env in
  let c = c0 in
  let b = kc c b3l in
  let p = var3 #c 0 1 2 in
  let (_, _, dz) = point_double_sv b p in
  Nil? (fst (ssub (dz) (smul (kc c 8) (smul (smul (smul (svar c 1) (svar c 1)) (svar c 1)) (svar c 2)))))

let k15_ok (o': fops m0) (env: list (elem m0)) : Lemma (k15_chk o' env == true) =
  assert (k15_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let k15 (x y z: P.felem)
  : Lemma (ensures (let (_, _, z3) = P.point_double (x, y, z) in z3 == P.fmul (cst 8) (P.fmul (P.fmul (P.fmul y y) y) z)))
  = let env = [fromf x; fromf y; fromf z] in
    k15_ok o env;
    let c0 = base m0 fl o 3 env in
    o_ok (); base_ok m0 fl o 3 env;
    let c = c0 in
    envf3 c x y z;
    o_eqs (); m0_lem (); bl_lem (); cst_lem (); fneg_lem ();
    let b = kc c b3l in
    assert_norm (b3l % m0 == b3l);
    let p = var3 #c 0 1 2 in
    let (_, _, dz) = point_double_sv b p in
    var3_val c 0 1 2;
    point_double_val c b p;
    kc_val c 8;
    assert (Nil? (fst (ssub (dz) (smul (kc c 8) (smul (smul (smul (svar c 1) (svar c 1)) (svar c 1)) (svar c 2))))));
    sv_eq (dz) (smul (kc c 8) (smul (smul (smul (svar c 1) (svar c 1)) (svar c 1)) (svar c 2)));
    ()
#pop-options

(** Doubling at infinity. *)
let k16_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 1 env in
  let c = c0 in
  let b = kc c b3l in
  let p = (kc c 0, svar c 0, kc c 0) in
  let (dx, dy, dz) = point_double_sv b p in
  Nil? (fst (ssub (dx) (kc c 0))) &&
  Nil? (fst (ssub (dy) (smul (smul (svar c 0) (svar c 0)) (smul (svar c 0) (svar c 0))))) &&
  Nil? (fst (ssub (dz) (kc c 0)))

let k16_ok (o': fops m0) (env: list (elem m0)) : Lemma (k16_chk o' env == true) =
  assert (k16_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let k16 (y: P.felem)
  : Lemma (ensures P.point_double (0, y, 0) == (0, P.fmul (P.fmul y y) (P.fmul y y), 0))
  = let env = [fromf y] in
    k16_ok o env;
    let c0 = base m0 fl o 1 env in
    o_ok (); base_ok m0 fl o 1 env;
    let c = c0 in
    envf1 c y;
    o_eqs (); m0_lem (); bl_lem (); cst_lem (); fneg_lem ();
    let b = kc c b3l in
    assert_norm (b3l % m0 == b3l);
    let p = (kc c 0, svar c 0, kc c 0) in
    let (dx, dy, dz) = point_double_sv b p in
    kc_val c 0;
    point_double_val c b p;
    assert (Nil? (fst (ssub (dx) (kc c 0))));
    sv_eq (dx) (kc c 0);
    assert (Nil? (fst (ssub (dy) (smul (smul (svar c 0) (svar c 0)) (smul (svar c 0) (svar c 0))))));
    sv_eq (dy) (smul (smul (svar c 0) (svar c 0)) (smul (svar c 0) (svar c 0)));
    assert (Nil? (fst (ssub (dz) (kc c 0))));
    sv_eq (dz) (kc c 0);
    ()
#pop-options

(** Both sides of the equation are cubic forms. *)
let k17_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 4 env in
  let c = c0 in
  let b = kc c b3l in
  let p = var3 #c 1 2 3 in
  let q = ksc (svar c 0) p in
  let s3 = smul (smul (svar c 0) (svar c 0)) (svar c 0) in
  Nil? (fst (ssub (eqn_lsv q) (smul s3 (eqn_lsv p)))) &&
  Nil? (fst (ssub (eqn_rsv q) (smul s3 (eqn_rsv p))))

let k17_ok (o': fops m0) (env: list (elem m0)) : Lemma (k17_chk o' env == true) =
  assert (k17_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let k17 (s x y z: P.felem)
  : Lemma (ensures (let q = Pj.scale #P.prime s (x, y, z) in let s3 = P.fmul (P.fmul s s) s in eqn_l q == P.fmul s3 (eqn_l (x, y, z)) /\ eqn_r q == P.fmul s3 (eqn_r (x, y, z))))
  = let env = [fromf s; fromf x; fromf y; fromf z] in
    k17_ok o env;
    let c0 = base m0 fl o 4 env in
    o_ok (); base_ok m0 fl o 4 env;
    let c = c0 in
    envf4 c s x y z;
    o_eqs (); m0_lem (); bl_lem (); cst_lem (); fneg_lem ();
    let b = kc c b3l in
    assert_norm (b3l % m0 == b3l);
    let p = var3 #c 1 2 3 in
    let q = ksc (svar c 0) p in
    let s3 = smul (smul (svar c 0) (svar c 0)) (svar c 0) in
    var3_val c 1 2 3;
    ksc_val c (svar c 0) p;
    eqn_val c q;
    eqn_val c p;
    assert (Nil? (fst (ssub (eqn_lsv q) (smul s3 (eqn_lsv p)))));
    sv_eq (eqn_lsv q) (smul s3 (eqn_lsv p));
    assert (Nil? (fst (ssub (eqn_rsv q) (smul s3 (eqn_rsv p)))));
    sv_eq (eqn_rsv q) (smul s3 (eqn_rsv p));
    ()
#pop-options

(** The equation at [z = 1] is the affine one. *)
let k18_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 2 env in
  let c = c0 in
  let b = kc c b3l in
  let p = aff #c 0 1 in
  Nil? (fst (ssub (eqn_lsv p) (smul (svar c 1) (svar c 1)))) &&
  Nil? (fst (ssub (eqn_rsv p) (crv c (svar c 0))))

let k18_ok (o': fops m0) (env: list (elem m0)) : Lemma (k18_chk o' env == true) =
  assert (k18_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let k18 (x y: P.felem)
  : Lemma (ensures eqn_l (x, y, P.fone) == P.fmul y y /\ eqn_r (x, y, P.fone) == ff x)
  = let env = [fromf x; fromf y] in
    k18_ok o env;
    let c0 = base m0 fl o 2 env in
    o_ok (); base_ok m0 fl o 2 env;
    let c = c0 in
    envf2 c x y;
    o_eqs (); m0_lem (); bl_lem (); cst_lem (); fneg_lem ();
    let b = kc c b3l in
    assert_norm (b3l % m0 == b3l);
    let p = aff #c 0 1 in
    aff_val c 0 1;
    eqn_val c p;
    crv_val c (svar c 0);
    assert (Nil? (fst (ssub (eqn_lsv p) (smul (svar c 1) (svar c 1)))));
    sv_eq (eqn_lsv p) (smul (svar c 1) (svar c 1));
    assert (Nil? (fst (ssub (eqn_rsv p) (crv c (svar c 0)))));
    sv_eq (eqn_rsv p) (crv c (svar c 0));
    ()
#pop-options

(** Negation preserves both sides of the equation. *)
let k19_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 3 env in
  let c = c0 in
  let b = kc c b3l in
  let p = var3 #c 0 1 2 in
  Nil? (fst (ssub (eqn_lsv (sneg p)) (eqn_lsv p))) &&
  Nil? (fst (ssub (eqn_rsv (sneg p)) (eqn_rsv p)))

let k19_ok (o': fops m0) (env: list (elem m0)) : Lemma (k19_chk o' env == true) =
  assert (k19_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 50"
let k19 (x y z: P.felem)
  : Lemma (ensures eqn_l (P.point_negate (x, y, z)) == eqn_l (x, y, z) /\ eqn_r (P.point_negate (x, y, z)) == eqn_r (x, y, z))
  = let env = [fromf x; fromf y; fromf z] in
    k19_ok o env;
    let c0 = base m0 fl o 3 env in
    o_ok (); base_ok m0 fl o 3 env;
    let c = c0 in
    envf3 c x y z;
    o_eqs (); m0_lem (); bl_lem (); cst_lem (); fneg_lem ();
    let b = kc c b3l in
    assert_norm (b3l % m0 == b3l);
    let p = var3 #c 0 1 2 in
    var3_val c 0 1 2;
    sneg_val c p;
    eqn_val c (sneg p);
    eqn_val c p;
    assert (Nil? (fst (ssub (eqn_lsv (sneg p)) (eqn_lsv p))));
    sv_eq (eqn_lsv (sneg p)) (eqn_lsv p);
    assert (Nil? (fst (ssub (eqn_rsv (sneg p)) (eqn_rsv p))));
    sv_eq (eqn_rsv (sneg p)) (eqn_rsv p);
    ()
#pop-options
