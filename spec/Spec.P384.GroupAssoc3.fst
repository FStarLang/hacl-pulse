(** Polynomial identities behind the P-384 group law.  Each [_chk] is a
    boolean computed by the normaliser (in [_ok]); the lemma of the same
    name reads it back as a statement about [Spec.P384].  Generated by a
    script; the identities themselves were found with a computer-algebra
    system and are merely confirmed here. *)
module Spec.P384.GroupAssoc3

open Spec.Group.Poly
open Spec.Group.Check
open Spec.P384.GroupSv
open Spec.P384.GroupNR
module P = Spec.P384
module Pj = Spec.Group.Proj

(** Associativity on affine points, cross product 3 of 3. *)
let assoc3_chk (o': fops m0) (env: list (elem m0)) : bool =
  let c0 = base m0 fl o' 6 env in
  let hs = [aff_hyp c0 0 1; aff_hyp c0 2 3; aff_hyp c0 4 5] in
  let c = with_hyps c0 hs in
  let b = kc c bl in
  let p = aff #c 0 1 in
  let q = aff #c 2 3 in
  let r = aff #c 4 5 in
  let (lx, ly, lz) = point_add_sv b (point_add_sv b p q) r in
  let (rx, ry, rz) = point_add_sv b p (point_add_sv b q r) in
  shapes hs &&
  Nil? (fst (ssub (smul ly rz) (smul ry lz)))

let assoc3_ok (o': fops m0) (env: list (elem m0)) : Lemma (assoc3_chk o' env == true) =
  assert (assoc3_chk o' env == true) by (poly_tac ())

#push-options "--fuel 0 --ifuel 1 --z3rlimit 100"
let assoc3_ctx (x1 y1 x2 y2 x3 y3: P.felem)
  : Lemma (requires on x1 y1 /\ on x2 y2 /\ on x3 y3)
          (ensures (let env = [fromf x1; fromf y1; fromf x2; fromf y2; fromf x3; fromf y3] in
                    let c0 = base m0 fl o 6 env in
                    let c = with_hyps c0 [aff_hyp c0 0 1; aff_hyp c0 2 3; aff_hyp c0 4 5] in
                    ok c /\ c.m == m0 /\ c.o == o /\ c.nv == 6 /\ c.env == env))
  = o_ok (); o_eqs ();
    let env = [fromf x1; fromf y1; fromf x2; fromf y2; fromf x3; fromf y3] in
    let c0 = base m0 fl o 6 env in
    base_ok m0 fl o 6 env;
    envf6 c0 x1 y1 x2 y2 x3 y3;
    aff_hyp_ok c0 0 1;
    aff_hyp_ok c0 2 3;
    aff_hyp_ok c0 4 5;
    holds3 (aff_hyp c0 0 1) (aff_hyp c0 2 3) (aff_hyp c0 4 5);
    hyps_ok c0 [aff_hyp c0 0 1; aff_hyp c0 2 3; aff_hyp c0 4 5]

let assoc3 (x1 y1 x2 y2 x3 y3: P.felem)
  : Lemma (requires on x1 y1 /\ on x2 y2 /\ on x3 y3)
          (ensures (let a = (x1, y1, P.fone) in let b = (x2, y2, P.fone) in let c = (x3, y3, P.fone) in let (lx, ly, lz) = P.point_add (P.point_add a b) c in let (rx, ry, rz) = P.point_add a (P.point_add b c) in P.fmul ly rz == P.fmul ry lz))
  = let env = [fromf x1; fromf y1; fromf x2; fromf y2; fromf x3; fromf y3] in
    assoc3_ok o env;
    let c0 = base m0 fl o 6 env in
    assoc3_ctx x1 y1 x2 y2 x3 y3;
    let c = with_hyps c0 [aff_hyp c0 0 1; aff_hyp c0 2 3; aff_hyp c0 4 5] in
    envf6 c x1 y1 x2 y2 x3 y3;
    o_eqs (); m0_lem (); bl_lem (); cst_lem (); fneg_lem ();
    let b = kc c bl in
    assert_norm (bl % m0 == bl);
    let p = aff #c 0 1 in
    let q = aff #c 2 3 in
    let r = aff #c 4 5 in
    let (lx, ly, lz) = point_add_sv b (point_add_sv b p q) r in
    let (rx, ry, rz) = point_add_sv b p (point_add_sv b q r) in
    aff_val c 0 1;
    aff_val c 2 3;
    aff_val c 4 5;
    point_add_val c b p q;
    point_add_val c b (point_add_sv b p q) r;
    point_add_val c b q r;
    point_add_val c b p (point_add_sv b q r);
    assert (Nil? (fst (ssub (smul ly rz) (smul ry lz))));
    sv_eq (smul ly rz) (smul ry lz);
    ()
#pop-options
