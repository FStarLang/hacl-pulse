let tp0 (m: nat { m < 9 }) : ext_point =
  if m = 0 then point_at_infinity
  else if m = 1 then b0
  else if m = 2 then e0_2
  else if m = 3 then e0_3
  else if m = 4 then e0_4
  else if m = 5 then e0_5
  else if m = 6 then e0_6
  else if m = 7 then e0_7
  else e0_8

let tp0_ok0 (_: unit)
  : Lemma (CB.affine (tp0 0) /\ CB.isq (tp0 0) (0 * pow2 0))
  = CB.isq_zero (0 * pow2 0)

let tp0_ok1 (_: unit)
  : Lemma (CB.affine (tp0 1) /\ CB.isq (tp0 1) (1 * pow2 0))
  = bq0_1 ();
    assert (n0 == pow2 0)

let tp0_ok2 (_: unit)
  : Lemma (CB.affine (tp0 2) /\ CB.isq (tp0 2) (2 * pow2 0))
  = e0_2_ok ();
    assert (n0 == pow2 0)

let tp0_ok3 (_: unit)
  : Lemma (CB.affine (tp0 3) /\ CB.isq (tp0 3) (3 * pow2 0))
  = e0_3_ok ();
    assert (n0 == pow2 0)

let tp0_ok4 (_: unit)
  : Lemma (CB.affine (tp0 4) /\ CB.isq (tp0 4) (4 * pow2 0))
  = e0_4_ok ();
    assert (n0 == pow2 0)

let tp0_ok5 (_: unit)
  : Lemma (CB.affine (tp0 5) /\ CB.isq (tp0 5) (5 * pow2 0))
  = e0_5_ok ();
    assert (n0 == pow2 0)

let tp0_ok6 (_: unit)
  : Lemma (CB.affine (tp0 6) /\ CB.isq (tp0 6) (6 * pow2 0))
  = e0_6_ok ();
    assert (n0 == pow2 0)

let tp0_ok7 (_: unit)
  : Lemma (CB.affine (tp0 7) /\ CB.isq (tp0 7) (7 * pow2 0))
  = e0_7_ok ();
    assert (n0 == pow2 0)

let tp0_ok8 (_: unit)
  : Lemma (CB.affine (tp0 8) /\ CB.isq (tp0 8) (8 * pow2 0))
  = e0_8_ok ();
    assert (n0 == pow2 0)

let tp0_ok (m: nat { m < 9 })
  : Lemma (CB.affine (tp0 m) /\ CB.isq (tp0 m) (m * pow2 0))
  = if m = 0 then tp0_ok0 ()
    else if m = 1 then tp0_ok1 ()
    else if m = 2 then tp0_ok2 ()
    else if m = 3 then tp0_ok3 ()
    else if m = 4 then tp0_ok4 ()
    else if m = 5 then tp0_ok5 ()
    else if m = 6 then tp0_ok6 ()
    else if m = 7 then tp0_ok7 ()
    else (assert (m == 8); tp0_ok8 ())

