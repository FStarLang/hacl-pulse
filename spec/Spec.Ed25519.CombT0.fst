(** Tables 0 to 3 of the base-point comb, generated by
    [spec/group-gen/ed25519/comb.py].  Table [j] holds [m 256^j G] for [m] in [0..8],
    affine, each entry proved by the normaliser to be the previous one
    plus the table's base point.  See {!Spec.Ed25519.CombTable}. *)
module Spec.Ed25519.CombT0

module SM = Spec.Ed25519.Smul
module CB = Spec.Ed25519.Comb

open Spec.Curve25519
open Spec.Ed25519
open Spec.Ed25519.Group
open Spec.Ed25519.CombB

#push-options "--fuel 0 --ifuel 0 --z3rlimit 50"

(** {2 Table 0} *)

let bq0 (_: unit) : Lemma (CB.isq b0 n0)
  = b0_ok (); CB.isq_intro b0 n0

let bq0_1 (_: unit) : Lemma (CB.isq b0 (1 * n0))
  = bq0 (); CB.isq_one b0 n0

[@@"opaque_to_smt"]
let e0_2x : elem =
  assert_norm (24727413235106541002554574571675588834622768167397638456726423682521233608206 < prime);
  24727413235106541002554574571675588834622768167397638456726423682521233608206

