let tp3_ok (m: nat { m < 9 })
  : Lemma (CB.affine (tp3 m) /\ CB.isq (tp3 m) (m * pow2 24))
  = if m = 0 then tp3_ok0 ()
    else if m = 1 then tp3_ok1 ()
    else if m = 2 then tp3_ok2 ()
    else if m = 3 then tp3_ok3 ()
    else if m = 4 then tp3_ok4 ()
    else if m = 5 then tp3_ok5 ()
    else if m = 6 then tp3_ok6 ()
    else if m = 7 then tp3_ok7 ()
    else (assert (m == 8); tp3_ok8 ())

#pop-options
