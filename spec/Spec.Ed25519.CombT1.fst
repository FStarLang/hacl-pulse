let tp4 (m: nat { m < 9 }) : ext_point =
  if m = 0 then point_at_infinity
  else if m = 1 then b4
  else if m = 2 then e4_2
  else if m = 3 then e4_3
  else if m = 4 then e4_4
  else if m = 5 then e4_5
  else if m = 6 then e4_6
  else if m = 7 then e4_7
  else e4_8

let tp4_ok0 (_: unit)
  : Lemma (CB.affine (tp4 0) /\ CB.isq (tp4 0) (0 * pow2 32))
  = CB.isq_zero (0 * pow2 32)

let tp4_ok1 (_: unit)
  : Lemma (CB.affine (tp4 1) /\ CB.isq (tp4 1) (1 * pow2 32))
  = bq4_1 ();
    assert (n4 == pow2 32)

let tp4_ok2 (_: unit)
  : Lemma (CB.affine (tp4 2) /\ CB.isq (tp4 2) (2 * pow2 32))
  = e4_2_ok ();
    assert (n4 == pow2 32)

let tp4_ok3 (_: unit)
  : Lemma (CB.affine (tp4 3) /\ CB.isq (tp4 3) (3 * pow2 32))
  = e4_3_ok ();
    assert (n4 == pow2 32)

let tp4_ok4 (_: unit)
  : Lemma (CB.affine (tp4 4) /\ CB.isq (tp4 4) (4 * pow2 32))
  = e4_4_ok ();
    assert (n4 == pow2 32)

let tp4_ok5 (_: unit)
  : Lemma (CB.affine (tp4 5) /\ CB.isq (tp4 5) (5 * pow2 32))
  = e4_5_ok ();
    assert (n4 == pow2 32)

let tp4_ok6 (_: unit)
  : Lemma (CB.affine (tp4 6) /\ CB.isq (tp4 6) (6 * pow2 32))
  = e4_6_ok ();
    assert (n4 == pow2 32)

let tp4_ok7 (_: unit)
  : Lemma (CB.affine (tp4 7) /\ CB.isq (tp4 7) (7 * pow2 32))
  = e4_7_ok ();
    assert (n4 == pow2 32)

let tp4_ok8 (_: unit)
  : Lemma (CB.affine (tp4 8) /\ CB.isq (tp4 8) (8 * pow2 32))
  = e4_8_ok ();
    assert (n4 == pow2 32)

let tp4_ok (m: nat { m < 9 })
  : Lemma (CB.affine (tp4 m) /\ CB.isq (tp4 m) (m * pow2 32))
  = if m = 0 then tp4_ok0 ()
    else if m = 1 then tp4_ok1 ()
    else if m = 2 then tp4_ok2 ()
    else if m = 3 then tp4_ok3 ()
    else if m = 4 then tp4_ok4 ()
    else if m = 5 then tp4_ok5 ()
    else if m = 6 then tp4_ok6 ()
    else if m = 7 then tp4_ok7 ()
    else (assert (m == 8); tp4_ok8 ())

