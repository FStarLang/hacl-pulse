(** Tables 4 to 7 of the base-point comb, generated by
    [spec/group-gen/ed25519/comb.py].  Table [j] holds [m 256^j G] for [m] in [0..8],
    affine, each entry proved by the normaliser to be the previous one
    plus the table's base point.  See {!Spec.Ed25519.CombTable}. *)
module Spec.Ed25519.CombT1

module SM = Spec.Ed25519.Smul
module CB = Spec.Ed25519.Comb

open Spec.Curve25519
open Spec.Ed25519
open Spec.Ed25519.Group
open Spec.Ed25519.CombB

#push-options "--fuel 0 --ifuel 0 --z3rlimit 50"

(** {2 Table 4} *)

let bq4 (_: unit) : Lemma (CB.isq b4 n4)
  = b4_ok (); CB.isq_intro b4 n4

let bq4_1 (_: unit) : Lemma (CB.isq b4 (1 * n4))
  = bq4 (); CB.isq_one b4 n4

[@@"opaque_to_smt"]
let e4_2x : elem =
  assert_norm (34085450069500794510152409520807677869950508039913904939590977699961040436501 < prime);
  34085450069500794510152409520807677869950508039913904939590977699961040436501

