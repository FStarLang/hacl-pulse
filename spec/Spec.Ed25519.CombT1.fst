  assert_norm (6446406076878883164533341186824663052309953784530127776470524942864456901624 < prime);
  6446406076878883164533341186824663052309953784530127776470524942864456901624

let e4_2 : ext_point = (e4_2x, e4_2y, one, e4_2t)

let e4_2_ok (_: unit) : Lemma (CB.isq e4_2 (2 * n4))
  = assert_norm (CB.ncheck e4_2 b4 b4);
    bq4_1 ();
    bq4 ();
    CB.isq_step b4 b4 e4_2 1 n4

