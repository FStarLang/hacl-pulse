(** Tables 8 to 11 of the base-point comb, generated by
    [spec/group-gen/ed25519/comb.py].  Table [j] holds [m 256^j G] for [m] in [0..8],
    affine, each entry proved by the normaliser to be the previous one
    plus the table's base point.  See {!Spec.Ed25519.CombTable}. *)
module Spec.Ed25519.CombT2

module SM = Spec.Ed25519.Smul
module CB = Spec.Ed25519.Comb

open Spec.Curve25519
open Spec.Ed25519
open Spec.Ed25519.Group
open Spec.Ed25519.CombB

#push-options "--fuel 0 --ifuel 0 --z3rlimit 50"

(** {2 Table 8} *)

let bq8 (_: unit) : Lemma (CB.isq b8 n8)
  = b8_ok (); CB.isq_intro b8 n8

let bq8_1 (_: unit) : Lemma (CB.isq b8 (1 * n8))
  = bq8 (); CB.isq_one b8 n8

[@@"opaque_to_smt"]
let e8_2x : elem =
  assert_norm (1010247752756362260881243234901448331704228065985397871388404881884689704343 < prime);
  1010247752756362260881243234901448331704228065985397871388404881884689704343

