  19849296478328768495495805247695997168837367132856874395156421056346847466394

let e8_2 : ext_point = (e8_2x, e8_2y, one, e8_2t)

let e8_2_ok (_: unit) : Lemma (CB.isq e8_2 (2 * n8))
  = assert_norm (CB.ncheck e8_2 b8 b8);
    bq8_1 ();
    bq8 ();
    CB.isq_step b8 b8 e8_2 1 n8

