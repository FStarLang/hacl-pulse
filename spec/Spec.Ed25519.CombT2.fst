let tp8 (m: nat { m < 9 }) : ext_point =
  if m = 0 then point_at_infinity
  else if m = 1 then b8
  else if m = 2 then e8_2
  else if m = 3 then e8_3
  else if m = 4 then e8_4
  else if m = 5 then e8_5
  else if m = 6 then e8_6
  else if m = 7 then e8_7
  else e8_8

let tp8_ok0 (_: unit)
  : Lemma (CB.affine (tp8 0) /\ CB.isq (tp8 0) (0 * pow2 64))
  = CB.isq_zero (0 * pow2 64)

let tp8_ok1 (_: unit)
  : Lemma (CB.affine (tp8 1) /\ CB.isq (tp8 1) (1 * pow2 64))
  = bq8_1 ();
    assert (n8 == pow2 64)

let tp8_ok2 (_: unit)
  : Lemma (CB.affine (tp8 2) /\ CB.isq (tp8 2) (2 * pow2 64))
  = e8_2_ok ();
