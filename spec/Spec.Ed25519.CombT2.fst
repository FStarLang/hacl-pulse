let tp8_ok8 (_: unit)
  : Lemma (CB.affine (tp8 8) /\ CB.isq (tp8 8) (8 * pow2 64))
  = e8_8_ok ();
    assert (n8 == pow2 64)

let tp8_ok (m: nat { m < 9 })
  : Lemma (CB.affine (tp8 m) /\ CB.isq (tp8 m) (m * pow2 64))
  = if m = 0 then tp8_ok0 ()
    else if m = 1 then tp8_ok1 ()
    else if m = 2 then tp8_ok2 ()
    else if m = 3 then tp8_ok3 ()
    else if m = 4 then tp8_ok4 ()
    else if m = 5 then tp8_ok5 ()
    else if m = 6 then tp8_ok6 ()
    else if m = 7 then tp8_ok7 ()
    else (assert (m == 8); tp8_ok8 ())

